<Project>

  <!-- Same two overrides as the agent project, for the same reason and verified the same way: the
       repository root turns central package management on in Directory.Build.props as well as
       Directory.Packages.props, so a project that declares its own versions must disable both or every
       Version= below is an NU1008 error. -->
  <PropertyGroup>
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CoreRentalNet.Agents.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- NU1903/NU1605: the Agent Framework hosting package is preview, as in the agent project. -->
    <NoWarn>$(NoWarn);NU1903;NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions match the repository's own test stack so a reader sees one story, not two. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <!-- The contract is JSON Schema, and .NET ships no validator: instances are checked against the
         committed files by a real one. Test-only, and inside the self-contained agent project, so it
         never touches the application's package policy. -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <!-- Line coverage, so "90%" is a measurement rather than a claim. Test-only: it is a data collector
         and ships nothing to the deployable. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CoreRentalNet.Agents/CoreRentalNet.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Assembly metadata for AgentVersionTests: the metadata reader is proven against this assembly, so the
         test does not depend on whether the agent it runs beside was stamped by the pipeline. -->
    <AssemblyMetadata Include="BuildIdentityTestKey" Value="stamped-value" />
    <AssemblyMetadata Include="BuildIdentityTestBlankKey" Value="" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests read the same committed schemas the application pins its DTOs to. -->
    <Content Include="../../shared/contracts/*.json"
             Link="contracts/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
