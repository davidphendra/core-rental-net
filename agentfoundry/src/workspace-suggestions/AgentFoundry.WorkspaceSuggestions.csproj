<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentFoundry.WorkspaceSuggestions</RootNamespace>
  </PropertyGroup>

  <!-- The four-agent workflow this container runs: the graph, the nodes and the contract they trade.
       No dependency on CoreRentalNet: the catalogue is reached over HTTP, so the agent and the
       application meet at a schema rather than at a project reference. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <!-- The intent table's miss is logged, and that line is the only thing that shows the table has
         stopped being useful. Referenced directly because this project names the type. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- The model calls behind the two classifier ports. The interface only: which model, in which
         region, is a deployment decision and reaches this code as a dependency it is handed. -->
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <ItemGroup>
    <!-- The classifier implementations are internal: they are what a public port is satisfied with, and
         the composition root is what chooses them. The tests reach them directly rather than through a
         root, because what they assert about is what a model would have been shown. -->
    <InternalsVisibleTo Include="AgentFoundry.Tests" />
  </ItemGroup>

  <!-- The files the container reads while it runs: the intent table the rephraser consults, and the
       prompts the two classifiers send. Copied, because a container starts from a build output rather
       than from a checkout - and until now neither shipped, so the table had no file to load and the
       prompts had none to send. Linked under one folder so the container has one place to look. -->
  <ItemGroup>
    <Content Include="../../shared/intent/workspace-intents.json"
             Link="shared/intent/workspace-intents.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../shared/prompts/*.txt"
             Link="shared/prompts/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
