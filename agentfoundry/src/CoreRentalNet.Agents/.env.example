# Foundry project endpoint — auto-injected in hosted containers.
# Only set manually if running without `azd ai agent run`.
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployment name — must match a deployment in your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# The Foundry agent name hosting resolves a request by. Reserved by the hosting platform, which injects it
# into a deployed container; this local value must equal the azure.yaml service name. An absent value refuses
# startup by name rather than serving an agent nothing can find.
FOUNDRY_AGENT_NAME=core-rental-workspace-suggestion-agent

# Which credential the process presents to Foundry. A developer's machine has no managed identity, so a local
# run must be Development or the model client's first token request spends the network timeout failing to reach
# one. Hosting injects its own environment, so this line is only a local default.
DOTNET_ENVIRONMENT=Development

# The model transport's budget. Neither is a run's attempt count: NetworkTimeout is how long one model call may
# take, and MaximumRetryAttempts is how many times one failed call is retried by the transport.
# MODELTRANSPORT__NETWORKTIMEOUT=00:10:00
# MODELTRANSPORT__MAXIMUMRETRYATTEMPTS=2

# Observability. The hosting platform builds the OpenTelemetry providers and chooses the exporter: Azure
# Monitor when APPLICATIONINSIGHTS_CONNECTION_STRING is set (it is injected in a hosted container), OTLP when
# an endpoint is configured, console otherwise. The application adds no exporter of its own.
#
# Application Insights — auto-injected in hosted containers; set for local telemetry (optional).
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
#
# Local OTLP instead of a cloud backend — the .NET Aspire Dashboard receives this with no account:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#
# Whether the customer's sentence, prompts and model answers are attached to spans. On for now, revisited
# after a baseline period; set false to stop. Never a secret.
# TELEMETRY__CAPTURECONTENT=true

# The catalogue's MCP tools. The endpoint is the whole of it: the credential presented to the catalogue is the
# caller's own token, carried on the invocation, so there is no client id, no secret and no audience to configure.
# Never use a FOUNDRY_-prefixed name for a setting of our own: the platform reserves that prefix.
# CATALOGTOOLS__MCPENDPOINT=https://<host>/mcp

# Which agent a request that names none gets, when the deployment serves more than one. `azd ai agent invoke
# --local` sends no agent name, so a local container answers with this one; remotely the platform's
# FOUNDRY_AGENT_NAME already answers it. azure.yaml sets it per service.
# AGENTHOST__DEFAULTAGENTNAME=core-rental-workspace-suggestion-agent

# The echo agent: a test aid a console can address with `azd ai agent invoke echo-reverse-agent "<message>"`. It answers
# with the caller's own message, so it costs nothing; a deployment turns it off with ECHOAGENT__ISENABLED=false.
# ECHOAGENT__AGENTNAME=echo-reverse-agent
# ECHOAGENT__ISENABLED=true
