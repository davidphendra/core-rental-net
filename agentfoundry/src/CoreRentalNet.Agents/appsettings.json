{
  // The Foundry project this agent belongs to. Auto-injected by the hosting platform; a local run must
  // supply it (via .env or the environment). Deliberately empty: an empty required setting refuses startup
  // by name instead of silently connecting to the wrong project.
  "FOUNDRY_PROJECT_ENDPOINT": "",

  // The deployment that answers every run. Matches the deployment azure.yaml declares.
  "AZURE_AI_MODEL_DEPLOYMENT_NAME": "gpt-4.1-mini",

  // The Foundry agent name hosting resolves a request by. FOUNDRY_AGENT_NAME is reserved by the hosting
  // platform, which injects it into a deployed container; this value is the local default. The platform's
  // value overrides it by the standard configuration order, so a renamed agent is still acknowledged.
  "FOUNDRY_AGENT_NAME": "core-rental-workspace-suggestion-agent",

  // The model transport's own budget. NetworkTimeout is how long one model call may take before the transport
  // gives up on it; MaximumRetryAttempts is how many times one failed call is retried. These are NOT a run's
  // attempts - the workflow section below bounds how many times the sentence is read, and the two never share a
  // counter. A run carries a large context, so a call can take longer than the hundred-second client default.
  "ModelTransport": {
    "NetworkTimeout": "00:10:00",
    "MaximumRetryAttempts": 2
  },

  // The workflow's own bounds. How many attempts a run may make, how many retrieved products the composer is
  // shown, and how many words one component's search may carry and how long each may be. All are deployment
  // choices rather than code: the retry loop and the search vocabulary are bounded here, not hard-coded. The two
  // search bounds are also stated at the MCP tool boundary, which belongs to the application's solution, so the
  // contract is what keeps the two equal; this side is the one that makes the tool's refusal unreachable.
  "WorkspaceSuggestionWorkflow": {
    "MaximumAttemptCount": 3,
    "MaximumRetrievedProductsPerComponentForReranking": 15,
    "MaximumSelectedProductsPerComponent": 3,
    "MaximumSearchTermCountPerComponent": 8,
    "MaximumSearchTermCharacterCount": 80
  },

  // The catalogue's MCP tools. The endpoint is the whole of it: the credential presented to the catalogue is
  // the caller's own token, carried on the invocation, so the process holds no identity of its own to configure.
  // An absent endpoint leaves the agent unable to search rather than half-open.
  "CatalogTools": {
    "McpEndpoint": ""
  },

  // The echo agent: a test aid a console can address. It answers with the caller's own message, so it costs
  // nothing and needs no model. ECHOAGENT__ISENABLED=false turns it off in a deployment.
  "EchoAgent": {
    "AgentName": "echo-agent",
    "IsEnabled": true
  }
}
