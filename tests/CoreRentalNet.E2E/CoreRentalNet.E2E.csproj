<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoreRentalNet.E2E</RootNamespace>
    <!-- Nothing is mocked or intercepted here, so the suite starts a real server instead. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Host/CoreRentalNet.Host/CoreRentalNet.Host.csproj" ReferenceOutputAssembly="false" />
    <!-- Built, not compiled against: the fixture starts it as the identity provider for the real
         OIDC handshake, and the guard test probes its refusal to run outside Development. -->
    <ProjectReference Include="../CoreRentalNet.E2E.LocalProvider/CoreRentalNet.E2E.LocalProvider.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../CoreRentalNet.E2E.LocalAgent/CoreRentalNet.E2E.LocalAgent.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

</Project>
