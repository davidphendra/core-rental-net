<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoreRentalNet.Host.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Host/CoreRentalNet.Host/CoreRentalNet.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Assembly metadata for AppVersionTests: the metadata reader is proven against this assembly, so the
         test does not depend on whether the application it runs beside was stamped by the pipeline. -->
    <AssemblyMetadata Include="BuildIdentityTestKey" Value="stamped-value" />
    <AssemblyMetadata Include="BuildIdentityTestBlankKey" Value="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="JsonSchema.Net" />
    <!-- FakeLogger, so the start-up announcement is proven by what it logged rather than by reading the
         strings it builds. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>


  <ItemGroup>
    <!-- The contract is the ONE artefact shared with the agent tree, and there is no project reference
         either way. The tests read the same files the agent's tests read, so a drift in either direction
         fails here rather than in production. -->
    <Content Include="../../agentfoundry/shared/contracts/*.json"
             Link="contracts/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
