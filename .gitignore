# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.idea/

# The stylesheet build is development-time only and its output is committed, so the tooling
# itself is never committed.
node_modules/
package-lock.json

# Playwright
playwright-report/
test-results/
*.trace.zip

# OS
.DS_Store

# Secrets. A developer's own tenant values and client secret live here, never in a tracked file.
appsettings.Local.json
appsettings.*.local.json
.env
*.pfx

# SQLite transient files and tool output. A WAL sidecar is recreated on the next open, and a
# design-time or ingestion database is produced by a run rather than written by hand.
*.db-shm
*.db-wal
design-time.db
src/Tools/CoreRentalNet.CatalogIngestion/App_Data/
# The catalogue store is produced by the migrations at start-up, not committed.
src/Host/CoreRentalNet.Host/App_Data/catalog.db
