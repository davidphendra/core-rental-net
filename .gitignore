# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.idea/

# Local database (never commit runtime data)
src/**/App_Data/*
!src/**/App_Data/.gitkeep
*.db
*.db-shm
*.db-wal

# The stylesheet build is development-time only and its output is committed, so the tooling
# itself is never committed.
node_modules/
package-lock.json

# Playwright
playwright-report/
test-results/
*.trace.zip

# OS
.DS_Store

# Secrets. A developer's own tenant values and client secret live here, never in a tracked file.
appsettings.Local.json
appsettings.*.local.json
*.pfx
