<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CoreRentalNet.Evaluation</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The evaluation solution pins its Microsoft.Agents.AI versions independently of the agent host. -->
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1903;NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- AgentEval is pinned exactly. The evaluation solution is independent of the main application,
         so its MAF version can move with AgentEval's dependency floor without changing the host. -->
    <PackageReference Include="AgentEval" Version="1.0.0-rc.1" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.24.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.24.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoreRentalNet.Evaluation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Evaluation/Prompts/*.md">
      <LogicalName>CoreRentalNet.Evaluation.Prompts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Include="../../../Test_Script.md" Link="Test_Script.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../src/shared/data/products.json" Link="products.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
