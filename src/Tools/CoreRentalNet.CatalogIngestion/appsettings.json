{
  "Embedding": {
    "Provider": "Foundry",
    "Endpoint": "https://periang-foundry-demo-instance.services.ai.azure.com/api/projects/periang-foundry-demo-project",
    "Model": "text-embedding-3-small",
    "Width": 384
  },
  "Catalog": {
    "DatabasePath": "../../Host/CoreRentalNet.Host/App_Data/catalog.db"
  },
  "Database": {
    "Path": "../../Host/CoreRentalNet.Host/App_Data/discovery.db"
  },
  "Seed": {
    "MigrationsDirectory": "../../Modules/Discovery/CoreRentalNet.Modules.Discovery.Infrastructure/Migrations"
  },
  "Chunker": {
    "TokenLimit": 256,
    "BufferSize": 1,
    "ThresholdType": "Percentile",
