<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoreRentalNet.Modules.Workspace.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The hosted suggestion agent, reached as a Foundry agent and authenticated with the application's own
         identity. Three packages, one set: the agent SDK, the project client and the credential. They live
         here rather than in the host because this is the only project that names them. -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry" />
    <PackageReference Include="Azure.AI.Projects" />
    <!-- The per-agent endpoint client options the hosted agent is built with (ProjectOpenAIClientOptions). Named
         directly rather than reached transitively, because the token policy must be stated on these options. -->
    <PackageReference Include="Azure.AI.Extensions.OpenAI" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <!-- The suggestion reader is internal to this project, and it is the seam where the provider's streamed wire
         shape stops and the application's vocabulary begins. The integration tier is where that crossing is
         asserted, because nothing else can reach it. -->
    <InternalsVisibleTo Include="CoreRentalNet.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CoreRentalNet.Modules.Workspace.Domain/CoreRentalNet.Modules.Workspace.Domain.csproj" />
    <!-- Outward reference: this project implements the port the application project declares. -->
    <ProjectReference Include="../CoreRentalNet.Modules.Workspace.Application/CoreRentalNet.Modules.Workspace.Application.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/CoreRentalNet.BuildingBlocks.Infrastructure/CoreRentalNet.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

</Project>
