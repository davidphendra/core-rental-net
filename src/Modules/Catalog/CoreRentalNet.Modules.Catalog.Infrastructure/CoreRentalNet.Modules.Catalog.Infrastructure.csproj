<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoreRentalNet.Modules.Catalog.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreRentalNet.Modules.Catalog.Domain\CoreRentalNet.Modules.Catalog.Domain.csproj" />
    <!-- Outward reference: this project implements the port the application project declares. -->
    <ProjectReference Include="..\CoreRentalNet.Modules.Catalog.Application\CoreRentalNet.Modules.Catalog.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The record shape and the mapper that reads it are infrastructure-only. The rules the mapper
         enforces are tested from records alone, which needs the test project to see both. -->
    <InternalsVisibleTo Include="CoreRentalNet.Modules.Catalog.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped beside the assembly so the host can load it at runtime from any working directory. -->
    <Content Include="../../../shared/data/products.json" Link="Catalog/products.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
