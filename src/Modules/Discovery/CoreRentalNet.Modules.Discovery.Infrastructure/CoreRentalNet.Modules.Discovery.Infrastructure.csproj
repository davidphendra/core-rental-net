<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoreRentalNet.Modules.Discovery.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The vectors live in the ingestion tool's own SQLite file, searched with raw Microsoft.Data.Sqlite and
         the vec0 extension. There is no EF context any more: the module keeps no table of its own. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- The catalogue's name search: an in-memory index built from the snapshot, ranked by the package's
         Okapi BM25. The module reads the catalogue and owns the index that ranks it. -->
    <PackageReference Include="Lifti.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CoreRentalNet.Modules.Discovery.Domain/CoreRentalNet.Modules.Discovery.Domain.csproj" />
    <!-- Outward reference: this project implements the port the application project declares. -->
    <ProjectReference Include="../CoreRentalNet.Modules.Discovery.Application/CoreRentalNet.Modules.Discovery.Application.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/CoreRentalNet.BuildingBlocks.Infrastructure/CoreRentalNet.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

</Project>
