@inherits LayoutComponentBase
<a class="skip-link" href="#main">Skip to content</a>
<AppHeader />
<!-- data-interactive flips to true when the circuit is attached. Prerendered HTML says
         false, which is how the browser suite knows a click will be handled. -->
<main class="app-main" id="main" data-interactive="@(RendererInfo.IsInteractive.ToString().ToLowerInvariant())">
    @Body
</main>
<MobileBottomNav />
<AppFooter />
