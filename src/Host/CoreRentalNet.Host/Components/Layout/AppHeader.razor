@* Decorative bag icon: the mockups draw it, and nothing in this application needs it to do work. *@
<header class="app-header">
    <div class="container app-header__inner">
        <a class="app-header__brand" href="/">Core Rental</a>
        <nav class="app-header__nav" aria-label="Main">
            <NavLink class="app-header__link" href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink class="app-header__link" href="/builder">Workspace Builder</NavLink>
            <NavLink class="app-header__link" href="/extras">Accessory Store</NavLink>
        </nav>
        <span class="row">
            <AccountChip ReturnUrl="/" />
            <span class="app-header__icon" role="img" aria-label="Shopping bag, decorative">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M6 8h12l-1 12H7z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" />
            </svg>
            </span>
        </span>
    </div>
</header>
