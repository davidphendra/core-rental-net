@implements IDisposable
@inject WorkspaceSession Session
@inject NavigationManager Navigation
@* Summary and Rent stay disabled until the workspace holds something. *@
<nav class="bottom-nav" aria-label="Workspace">
    <NavLink class="bottom-nav__item" href="/builder">
        <span class="bottom-nav__glyph" aria-hidden="true">&#9635;</span>
        <span class="label-sm">Build</span>
    </NavLink>
    <NavLink class="bottom-nav__item" href="/extras">
        <span class="bottom-nav__glyph" aria-hidden="true">&#9636;</span>
        <span class="label-sm">Store</span>
    </NavLink>
    <a class="bottom-nav__item" href="/review"
       aria-disabled="@(Session.IsEmpty.ToString().ToLowerInvariant())"
       tabindex="@(Session.IsEmpty ? -1 : 0)"
       @onclick="GoToReviewAsync" @onclick:preventDefault="Session.IsEmpty">
        <span class="bottom-nav__glyph" aria-hidden="true">&#9776;</span>
        <span class="label-sm">Summary</span>
    </a>
    <a class="bottom-nav__item" href="/review"
       aria-disabled="@((!CanCheckout).ToString().ToLowerInvariant())"
       tabindex="@(CanCheckout ? 0 : -1)"
       @onclick="GoToReviewAsync" @onclick:preventDefault="@(!CanCheckout)">
        <span class="bottom-nav__glyph" aria-hidden="true">&#10003;</span>
        <span class="label-sm">Rent</span>
    </a>
</nav>

@code {
    [CascadingParameter(Name = "DraftToken")] public string? DraftToken { get; set; }

    private bool CanCheckout => Session.Current?.CanCheckout ?? false;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;

        if (!string.IsNullOrEmpty(DraftToken))
        {
            await Session.EnsureLoadedAsync(DraftToken);
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private Task GoToReviewAsync()
    {
        if (!Session.IsEmpty)
        {
            Navigation.NavigateTo("/review");
        }

        return Task.CompletedTask;
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
