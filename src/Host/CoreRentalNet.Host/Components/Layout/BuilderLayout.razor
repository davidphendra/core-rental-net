@inherits LayoutComponentBase
<a class="skip-link" href="#main">Skip to content</a>
<AppHeader />
<!-- data-interactive flips to true when the circuit is attached. Prerendered HTML says
         false, which is how the browser suite knows a click will be handled. -->
<main class="flex flex-1 w-full max-w-container-max mx-auto relative" id="main" data-interactive="@(RendererInfo.IsInteractive.ToString().ToLowerInvariant())">
    @Body
</main>
<MobileBottomNav />
@* The footer's content is centred on the content column here rather than the window, because the
   panel covers the left of it; that rule follows the panel, in base.css. *@
<AppFooter />
