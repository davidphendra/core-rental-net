@* The store card, from specs/design/bali_essentials_store/code.html, with its classes unchanged -
   including tropical-card, which the design defines by hand. Two deliberate differences: the root
   is a button rather than a clickable div, and the design's nested button is a span, because a
   button inside a button is invalid markup. *@
<button type="button"
        class="product-card text-left tropical-card bg-surface-container-lowest rounded-xl p-stack-md flex flex-col border border-surface-variant"
        aria-label="@($"Add {Product.Name} to your workspace")"
        @onclick="() => OnSelect.InvokeAsync(Product)">
    <div class="h-48 w-full bg-surface-container-low rounded-lg mb-stack-md relative overflow-hidden group">
        <ProductVisual AltText="@Product.Name" ImagePath="@Product.ImagePath" ImageAvailable="@Product.ImageAvailable"
                      Glyph="@ProductGlyph.ForProduct(Product.Category, Product.SubCategory)"
                      ImageClass="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      GlyphClass="absolute inset-0 m-auto w-1/3 h-1/3 text-primary-container" />

        @if (Product.IsFeatured)
        {
            <div class="absolute top-2 right-2 bg-secondary-container text-on-secondary-container text-label-sm font-label-sm px-2 py-1 rounded-full shadow-sm">
                Popular
            </div>
        }
    </div>

    @* The name and the price share a row while they fit and stack when they do not. An IDR price is
       one unbreakable token (for example Rp1.500.000), so at the design's headline size it
       overwhelmed the name in a four-column grid. The price is smaller, the row wraps, and
       break-words lets a value longer still wrap inside itself rather than overlap its neighbour. *@
    <div class="flex flex-wrap justify-between items-start gap-x-3 gap-y-1 mb-2">
        <h3 class="text-headline-md font-headline-md text-on-surface min-w-0 break-words">@Product.Name</h3>
        <span class="text-body-md font-body-md font-bold text-primary break-words">
            @Product.MonthlyPrice.Amount.ToString("C")<span class="text-label-sm font-label-sm text-on-surface-variant">/mo</span>
        </span>
    </div>

    <p class="text-body-md font-body-md text-on-surface-variant flex-1 mb-stack-md">@Product.Description</p>

    <span class="w-full border-2 border-primary text-primary hover:bg-primary hover:text-on-primary transition-colors py-2 rounded-lg font-bold flex justify-center items-center gap-2">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></svg>
        Add to Setup
    </span>
</button>

@code {
    [Parameter, EditorRequired] public ProductView Product { get; set; } = default!;

    [Parameter] public EventCallback<ProductView> OnSelect { get; set; }
}
