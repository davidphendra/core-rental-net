@inherits WorkspaceObserver
@inject GetCatalogPageHandler CatalogPage
@inject GetCatalogGroupHandler CatalogGroup
@* The docked panel the designs draw on the builder: browse a category, assign an item, and leave
   for the summary. It keeps its own browsing state, because what it shows has nothing to do with
   what the page beside it is doing.

   It keeps the height its design gives it - the window less the header, to the foot of the window -
   and the footer scrolls behind it. Shortening it by the footer's height instead left a strip of
   page showing beneath it while the page scrolled, with the panel's edge holding still beside it;
   the footer has no border and the page's own surface, so there is nothing to see behind it. *@
<aside class="hidden lg:flex flex-col gap-stack-md p-gutter fixed left-0 top-20 h-[calc(100vh-80px)] bg-surface-container-low shadow-sm w-80 z-40" aria-label="Selection panel">
    <div class="mb-4">
        <h2 class="text-headline-md font-headline-md text-primary font-extrabold">Selection Panel</h2>
        <p class="text-on-surface-variant text-label-md font-label-md mt-1">Build your setup</p>
    </div>

    <CategoryNav Selected="tab" OnSelect="SelectTabAsync" />

    @* Refusals are surfaced by the page, beside the canvas they concern. One error surface, and
       it is where the customer is looking. *@
    @* The catalog takes the rest of the panel. The design ends the panel with a link to the
       summary; that link is not here, by request, so the room it used is the catalog's. The
       floating bar is still the way out, and still closes until the workspace can be rented. *@
    <div class="flex-1 overflow-y-auto mt-4 border-t border-outline-variant pt-4 pr-2">
        <div class="grid grid-cols-2 gap-3">
            @foreach (var product in products)
            {
                <BuilderProductCard Product="product" IsSelected="@IsAssigned(product.Sku)" OnSelect="AssignAsync" />
            }
        </div>
    </div>
</aside>

@code {
    [CascadingParameter(Name = "DraftToken")] public string? DraftToken { get; set; }

    private CatalogTab tab = CatalogTab.Desks;
    private IReadOnlyList<ProductListItem> products = [];

    protected override void OnInitialized() => LoadProducts();

    private void LoadProducts() => products = CatalogTabs.Load(tab, CatalogPage, CatalogGroup);

    private Task SelectTabAsync(CatalogTab selected)
    {
        tab = selected;
        LoadProducts();
        return Task.CompletedTask;
    }

    private bool IsAssigned(string sku)
        => Session.Current?.Slots.Any(slot => slot.Holds(sku)) == true;

    private async Task AssignAsync(ProductListItem product)
    {
        if (!string.IsNullOrEmpty(DraftToken))
        {
            await Session.AssignAsync(DraftToken, product.Sku);
        }
    }
}
