@inherits WorkspaceObserver
@inject CatalogBrowser Browser
@* The docked panel the designs draw on the builder: browse a category, assign an item, and leave
   for the summary. It keeps its own browsing state, because what it shows has nothing to do with
   what the page beside it is doing.

   It keeps the height its design gives it - the window less the header, to the foot of the window -
   and the footer scrolls behind it. Shortening it by the footer's height instead left a strip of
   page showing beneath it while the page scrolled, with the panel's edge holding still beside it;
   the footer has no border and the page's own surface, so there is nothing to see behind it.

   Its search is its own, and belongs to the tab rather than to the panel: it narrows what the tab
   is showing, is emptied when another tab is chosen, and knows nothing about the picker's search. *@
<aside class="hidden lg:flex flex-col gap-stack-md p-gutter fixed left-0 top-20 h-[calc(100vh-80px)] bg-surface-container-low shadow-sm w-80 z-40" aria-label="Selection panel">
    <div class="mb-4">
        <h2 class="text-headline-md font-headline-md text-primary font-extrabold">Selection Panel</h2>
        <p class="text-on-surface-variant text-label-md font-label-md mt-1">Build your setup</p>
    </div>

    <CategoryNav Selected="Browser.Tab" OnSelect="SelectTab" />

    @* Refusals are surfaced by the page, beside the canvas they concern. One error surface, and
       it is where the customer is looking. *@
    @* The catalog takes the rest of the panel. The design ends the panel with a link to the
       summary; that link is not here, by request, so the room it used is the catalog's. The
       floating bar is still the way out, and still closes until the workspace can be rented. *@
    <div class="flex-1 min-h-0 flex flex-col gap-6 mt-4 pt-4">
        <SearchField Id="panel-search" Label="Search these products by name"
                     Value="@Browser.Query" ValueChanged="SetQueryAsync" />

        <div class="flex-1 min-h-0 overflow-y-auto pr-2 flex flex-col gap-stack-md">
            @if (Browser.Items.Count == 0)
            {
                <p class="body-md muted">@EmptyMessage</p>
            }
            else
            {
                @* One section per subcategory, headings only where a subcategory has a name to
                   show: desks and chairs arrive as one unlabelled group. *@
                @foreach (var group in AccessoryGroups.Of(Browser.Items))
                {
                    <section class="flex flex-col gap-3">
                        @if (group.Label.Length > 0)
                        {
                            <h3 class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider">@group.Label</h3>
                        }
                        <div class="grid grid-cols-2 gap-3">
                            @foreach (var product in group.Products)
                            {
                                <BuilderProductCard Product="product" IsSelected="@IsAssigned(product.Sku)" OnSelect="AssignAsync" />
                            }
                        </div>
                    </section>
                }
            }
        </div>
    </div>
</aside>

@code {
    [CascadingParameter(Name = "DraftToken")] public string? DraftToken { get; set; }

    protected override void OnInitialized()
    {
        // The base subscribes to the workspace, so a box removed on the canvas still clears the card
        // selected for it here. Overriding without calling it left the panel showing a selection the
        // workspace no longer had.
        base.OnInitialized();

        Browser.Reload();
    }

    private string EmptyMessage => string.IsNullOrWhiteSpace(Browser.Query)
        ? "Nothing in this category."
        : $"Nothing here is named \"{Browser.Query.Trim()}\".";

    private void SelectTab(CatalogTab selected) => Browser.SelectTab(selected);

    /// <summary>
    /// The one way the query changes: typed into the field, or cleared by its control. Either way the
    /// catalog is asked again, because the filtering is the query's to do.
    /// </summary>
    private Task SetQueryAsync(string value)
    {
        Browser.Search(value);

        return Task.CompletedTask;
    }

    private bool IsAssigned(string sku)
        => Session.Current?.Slots.Any(slot => slot.Holds(sku)) == true;

    private async Task AssignAsync(ProductListItem product)
    {
        if (!string.IsNullOrEmpty(DraftToken))
        {
            await Session.AssignAsync(DraftToken, product.Sku);
        }
    }
}
