@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@* Native <dialog>: focus trapping, Esc and an inert background come for free. *@
@* The frame is the design's classes rather than a scoped stylesheet. A .razor.css file is served
   in a bundle App.razor does not link, so anything written in one silently never loads - which is
   how this dialog came to have no padding at all. The classes below are kept as hooks: the browser
   tests find the panel and its actions by them. *@
<dialog @ref="element" class="modal w-full max-w-lg rounded-2xl border border-surface-variant bg-surface-bright shadow-ambient backdrop:bg-on-surface/40" @onclose="HandleClosedAsync" aria-labelledby="@TitleId">
    <div class="modal__panel flex flex-col gap-stack-md p-gutter">
        <h2 class="text-headline-md font-headline-md text-primary" id="@TitleId">@Title</h2>
        <div class="modal__body">@ChildContent</div>
        @if (Actions is not null)
        {
            <div class="modal__actions flex justify-end gap-stack-sm">@Actions</div>
        }
    </div>
</dialog>

@code {
    private IJSObjectReference? module;
    private ElementReference element;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public EventCallback OnClosed { get; set; }

    private string TitleId { get; } = $"dialog-title-{Guid.NewGuid():N}";

    public async Task ShowAsync()
    {
        module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/dialog.js");
        await module.InvokeVoidAsync("show", element);
        await InvokeAsync(FocusFirstFieldAsync);
    }

    /// <summary>Native dialog handles the focus trap; moving the caret into the first control is ours.</summary>
    private async Task FocusFirstFieldAsync()
    {
        module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/dialog.js");
        await module.InvokeVoidAsync("focusFirstField", element);
    }

    public async Task CloseAsync()
    {
        if (module is null)
        {
            return;
        }

        await module.InvokeVoidAsync("close", element);
        await OnClosed.InvokeAsync();
    }

    private Task HandleClosedAsync() => OnClosed.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            await module.DisposeAsync();
        }

        GC.SuppressFinalize(this);
    }
}
