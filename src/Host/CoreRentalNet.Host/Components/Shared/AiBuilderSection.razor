@* The AI section: ask for a suggestion, watch the run, and stop it if it takes too long.
   Gated by its own permission rather than the page's, because the page is a workspace builder and
   this is one thing it can additionally offer. A customer without the entitlement sees the builder
   unchanged, which is what a closed feature looks like from the outside. *@
@inject ISuggestWorkspaceOptions Suggestions
@inject IApplyCompositionHandler ApplyComposition
@inject IProductCatalog Catalog
@inject IAuthorizationService Authorization
@inject IAiRunGuard RunGuard
@inherits WorkspaceObserver

<AuthorizeView Policy="@AiBuilderReadPolicy.Name">
    <Authorized>
        <CompositionConfirmDialog @ref="confirmation"
                                  Message="@ConfirmMessage"
                                  Dropped="@pendingDropped"
                                  OnConfirm="ApplyAsync" />
        <section class="ai mb-section-gap" data-testid="ai-section" aria-labelledby="ai-heading">
            <h2 id="ai-heading" class="text-headline-sm font-display-lg text-primary mb-2">
                Not sure where to start?
            </h2>
            <p class="text-body-md font-body-md text-outline mb-stack-md">
                Describe the workspace you need, and we will put three options together.
            </p>

            @* In the document from the start, and empty until a run says something. A live region
               added to the page at the same moment as its first content is not reliably announced:
               the browser has to be observing the element before it changes, and an element that
               arrives already full never changes at all. So the region outlives the runs and only
               its text moves. *@
            <p class="sr-only" data-testid="ai-announcement" aria-live="polite">@announcement</p>

            <form class="ai__request flex flex-wrap gap-2 items-end" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                <label class="sr-only" for="ai-query">Describe your workspace</label>
                <input id="ai-query"
                       class="ai__query flex-1 min-w-0"
                       data-testid="ai-query"
                       placeholder="A desk, a chair and a monitor"
                       disabled="@running"
                       @bind="query"
                       @bind:event="oninput" />

                <button type="submit" class="ai__submit" data-testid="ai-submit"
                        disabled="@(running || string.IsNullOrWhiteSpace(query))">
                    Suggest
                </button>

                @if (running)
                {
                    <button type="button" class="ai__cancel" data-testid="ai-cancel" @onclick="Cancel">
                        Cancel
                    </button>
                }
            </form>

            @* Polite, and never assertive: a run passes through four stages, and interrupting a screen
               reader four times to say so is worse than not announcing them at all. The region is in
               the document from the first stage, because a live region added at the same time as its
               content is not announced. *@
            @if (stages.Count > 0)
            {
                @if (collapsed)
                {
                    <button type="button" class="ai__toggle" data-testid="ai-stages-toggle"
                            aria-expanded="false" @onclick="Expand">
                        What took so long?
                    </button>
                }
                else
                {
                    <ol class="ai__stages" data-testid="ai-stages">
                        @foreach (var (stage, attempt) in stages)
                        {
                            @* An id the application has no words for renders nothing rather than
                               leaking the agent's vocabulary onto the page. *@
                            @if (SuggestionStageCopy.For(stage) is { } words)
                            {
                                <li class="ai__stage" data-stage="@stage">
                                    @words
                                    @if (SuggestionStageCopy.Attempt(attempt) is { } which)
                                    {
                                        <span class="ai__attempt">@which</span>
                                    }
                                </li>
                            }
                        }
                    </ol>
                }
            }

            @if (refused is not null)
            {
                <p class="alert" role="status" data-testid="ai-refused">@refused</p>
            }

            @* What an apply did, said where the customer is looking rather than in the dialog they
               have already dismissed. *@
            @if (applyError is not null)
            {
                <p class="alert" role="alert" data-testid="apply-refused">@applyError</p>
            }

            @if (appliedDropped.Count > 0)
            {
                <p class="alert" role="status" data-testid="apply-dropped">
                    Not included, because they are no longer in our catalogue: @string.Join(", ", appliedDropped).
                </p>
            }

            @if (outcome is not null)
            {
                <div class="ai__outcome" data-testid="ai-outcome" data-status="@outcome.Status">
                    @switch (outcome.Status)
                    {
                        case SuggestionStatus.Rejected:
                            @* Guidance rather than a retry: the same words sent again produce the same
                               refusal, so what helps is being told what would. *@
                            <p class="ai__message" data-testid="ai-refusal" role="status">
                                @OutcomeCopy.Refusal(outcome.Code)
                            </p>
                            break;

                        case SuggestionStatus.Unavailable:
                            @* The application's own outcome, and the only one offering another go. *@
                            <p class="ai__message" data-testid="ai-error" role="alert">
                                @OutcomeCopy.Unreachable
                            </p>
                            <button type="button" class="ai__retry" data-testid="ai-retry" @onclick="SubmitAsync">
                                @OutcomeCopy.Retry
                            </button>
                            break;

                        default:
                            @if (outcome.Status == SuggestionStatus.Exhausted)
                            {
                                @* A result with a caveat rather than a failure: the candidates are here
                                   and they can be chosen. *@
                                <p class="ai__caveat" data-testid="ai-caveat" role="status">
                                    @OutcomeCopy.Caveat
                                </p>
                            }

                            @if (outcome.Findings.Count > 0)
                            {
                                <ul class="ai__findings" data-testid="ai-findings">
                                    @foreach (var finding in outcome.Findings)
                                    {
                                        <li class="ai__finding">@OutcomeCopy.Finding(finding)</li>
                                    }
                                </ul>
                            }

                            @foreach (var option in CandidateChoices.Visible(outcome.Options, threeCandidates))
                            {
                                <article class="ai__option" data-testid="ai-option" data-tier="@option.Tier">
                                    <h3 class="text-title-md font-title-md text-primary">@OutcomeCopy.Tier(option.Tier)</h3>
                                    <ul class="ai__lines">
                                        @foreach (var line in option.Lines)
                                        {
                                            <li class="ai__line" data-sku="@line.Sku">
                                                @line.Name
                                                <span class="ai__quantity">&times; @line.Quantity</span>
                                            </li>
                                        }
                                    </ul>

                                    @if (option.Criteria.Count > 0)
                                    {
                                        <p class="ai__criteria" data-testid="ai-criteria">
                                            @string.Join(", ", option.Criteria.Select(OutcomeCopy.Criterion))
                                        </p>
                                    }

                                    <button type="button" class="ai__apply" data-testid="ai-apply"
                                            data-tier="@option.Tier" @onclick="() => SelectAsync(option)">
                                        Use this setup
                                    </button>

                                    @if (option.Unevaluated.Count > 0)
                                    {
                                        @* The customer's own words, quoted, because they are the only
                                           free text in the contract and they came from the request. *@
                                        <p class="ai__unevaluated" data-testid="ai-unevaluated">
                                            We could not check:
                                            @foreach (var phrase in option.Unevaluated)
                                            {
                                                <span class="ai__unevaluated-item">&ldquo;@phrase&rdquo;</span>
                                            }
                                        </p>
                                    }
                                </article>
                            }
                            break;
                    }
                </div>
            }
        </section>
    </Authorized>
</AuthorizeView>

@code {
    private readonly List<(string Stage, int Attempt)> stages = [];
    private string query = string.Empty;
    private WorkspaceSuggestion? outcome;
    private CancellationTokenSource? run;
    private bool running;
    private bool collapsed;
    private SuggestedOption? pending;
    private IReadOnlyList<CompositionLine> pendingLines = [];
    private IReadOnlyList<string> pendingDropped = [];
    private IReadOnlyList<string> appliedDropped = [];
    private string? applyError;
    private string? refused;
    private string? principal;

    /// <summary>What a screen reader is told, which is the stage the run has just reached.</summary>
    private string announcement = string.Empty;

    /// <summary>
    /// Whether this account is entitled to all three candidates.
    /// </summary>
    /// <remarks>
    /// Read from the permission rather than from the markup, because the count is a decision about what
    /// to offer. Truncating in the render would leave the other candidates in the document, which is a
    /// control a customer can reach by looking rather than a choice we made.
    /// </remarks>
    private bool threeCandidates;

    /// <summary>Which draft to replace. Supplied by the page, which is the thing that knows.</summary>
    [Parameter] public string? Token { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        var state = await AuthenticationState;

        principal = state.User.Identity?.Name;
        threeCandidates = (await Authorization.AuthorizeAsync(state.User, AiBuilderPowerPolicy.Name)).Succeeded;
    }

    /// <summary>
    /// Runs the suggestion, rendering what it says as it says it.
    /// </summary>
    /// <remarks>
    /// Nothing is applied here and nothing is written: the run proposes options and the page holds them
    /// until one is chosen, which is what makes cancelling safe by construction rather than by
    /// remembering to undo something.
    /// </remarks>
    private async Task SubmitAsync()
    {
        // Asked before anything else, and answered here rather than by the agent: a second click must not
        // cost a second run, and the cost is the thing being controlled.
        if (!TryBegin())
        {
            refused = OutcomeCopy.AlreadyRunning;
            return;
        }

        refused = null;

        run?.Dispose();
        run = new CancellationTokenSource();

        var token = run.Token;

        stages.Clear();
        outcome = null;
        announcement = string.Empty;
        collapsed = false;
        running = true;

        try
        {
            await foreach (var update in Suggestions.SuggestAsync(new WorkspaceSuggestionRequest(query), token))
            {
                if (update.Kind == "stage")
                {
                    stages.Add((update.Stage ?? string.Empty, update.Attempt));
                    announcement = Announced(update.Stage, update.Attempt);
                }
                else
                {
                    outcome = update.Outcome;
                }

                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // The customer stopped it. There is nothing to undo, and no outcome to report: a cancelled
            // run is not an answer, and saying "unavailable" would blame the agent for our own cancel.
        }
        finally
        {
            running = false;

            // Released here rather than after a successful run, because every way a run can end passes
            // through this - including a cancel, and a failure. A guard that outlived its run would
            // punish the customer for stopping one.
            ReleaseRun();

            // Retained, and collapsed: the answer to "why did that take so long" outlives the run, and
            // the options take the visual focus.
            collapsed = stages.Count > 0;
        }
    }

    /// <summary>Takes the run slot, or reports that there is not one to take.</summary>
    /// <remarks>
    /// A deployment that has somehow reached this without an identity is allowed to run: the guard is a
    /// cost control on an authenticated feature, and refusing an anonymous caller here would be a
    /// permission decision made in the wrong place.
    /// </remarks>
    private bool TryBegin()
        => principal is null || RunGuard.TryBegin(principal);

    private void ReleaseRun()
    {
        if (principal is not null)
        {
            RunGuard.Release(principal);
        }
    }

    /// <summary>Stops the run. The stream ends, and no candidate is left behind.</summary>
    private void Cancel() => run?.Cancel();

    /// <summary>
    /// The customer chose a candidate: work out what applying it means, then ask if there is anything to
    /// lose.
    /// </summary>
    /// <remarks>
    /// The composition is worked out before the dialog appears rather than after it is confirmed, because
    /// a product that has left the catalogue since the run is part of what the customer is agreeing to -
    /// and being told about it after the fact would make the confirmation a formality.
    /// </remarks>
    private async Task SelectAsync(SuggestedOption option)
    {
        ArgumentNullException.ThrowIfNull(option);

        var (lines, dropped) = CompositionFromOption.From(option, Catalog);

        pending = option;
        pendingLines = lines;
        pendingDropped = dropped;
        applyError = null;
        appliedDropped = [];

        if (Session.IsEmpty || lines.Count == 0)
        {
            await ApplyAsync();
            return;
        }

        confirmation ??= new CompositionConfirmDialog();

        await confirmation.ShowAsync();
    }

    /// <summary>
    /// Replaces the draft's slots with the chosen composition, if the draft has not moved on.
    /// </summary>
    /// <remarks>
    /// The version the composition was chosen against is sent with it. If another tab changed the draft
    /// while the run was happening, nothing is written and the customer is told the workspace changed -
    /// which is the loud half of the rule that a draft is only edited deliberately.
    /// </remarks>
    private async Task ApplyAsync()
    {
        if (pending is null || Session.Current is null || string.IsNullOrWhiteSpace(Token))
        {
            return;
        }

        applyError = null;
        appliedDropped = [];

        var applied = await ApplyComposition.HandleAsync(
            new ApplyCompositionCommand(Token, Session.Current.Version, pendingLines));

        if (applied == CompositionApplyOutcome.Stale)
        {
            // Not applied, and said so: the customer's other work is still there, and what they need to
            // do is look at it rather than press the button again.
            applyError = ApplyStaleCopy;
            return;
        }

        appliedDropped = pendingDropped;

        await Session.RefreshAsync(Token);

        // The candidates belonged to the workspace as it was, so they go with it.
        outcome = null;
        pending = null;
        stages.Clear();
        collapsed = false;
    }

    private void Expand() => collapsed = false;

    /// <summary>The stage as a screen reader hears it, or nothing for an id we have no words for.</summary>
    /// <remarks>
    /// The attempt is part of the sentence on purpose: two attempts at the same stage would otherwise
    /// produce identical text, and a live region whose text does not change is not announced at all - so
    /// the second attempt would pass in silence.
    /// </remarks>
    private static string Announced(string? stage, int attempt)
        => SuggestionStageCopy.For(stage) is { } words
            ? SuggestionStageCopy.Attempt(attempt) is { } which ? $"{words}, {which}" : words
            : string.Empty;

    /// <summary>What the dialog tells the customer will be replaced.</summary>
    /// <remarks>
    /// It names the count and the setup, because "replace your workspace" is a question a customer cannot
    /// answer without knowing both halves of it.
    /// </remarks>
    private string ConfirmMessage
        => $"Your workspace already has {Session.TotalUnits} item{(Session.TotalUnits == 1 ? "" : "s")} in it. "
            + $"Replacing it with the {OutcomeCopy.Tier(pending?.Tier)} setup clears what is there and uses these instead. "
            + "Your delivery address is kept either way.";

    /// <summary>What the page says when the draft moved on between the run and the apply.</summary>
    private const string ApplyStaleCopy =
        "Your workspace changed while we were working, so nothing was replaced. Have a look at it and ask again.";

    private CompositionConfirmDialog? confirmation;

    public override void Dispose()
    {
        run?.Cancel();

        // The circuit going away ends the run as surely as a cancel does, and an unreleased slot would
        // lock the customer out of the feature until the cooldown they can no longer see has passed.
        ReleaseRun();

        run?.Dispose();

        base.Dispose();
    }
}
