@* The AI section: ask for a suggestion, read the run as it happens, and stop it if it takes too long.

   Gated twice, and the gates answer different questions. `AgentFoundrySettings` says whether this
   deployment has an agent at all, so a deployment without one looks exactly as it did before the feature
   existed. The permission says whether this customer may spend. Neither is authorisation on its own: the
   endpoint checks the permission for itself, because a section that is not rendered is presentation rather
   than a gate.

   There is no index-freshness gate any more. The application no longer searches the catalogue before the run;
   the agent does, through the MCP tools, and reports an unusable index as a tool failure the run words. *@
@using System.Text.Json
@using CoreRentalNet.Host.Agents
@using CoreRentalNet.Host.AiBuilder
@using CoreRentalNet.Modules.Workspace.Application.Commands.ReplaceComposition
@inject IJSRuntime JavaScript
@inject AgentFoundrySettings Agent
@inject SuggestionAvailability Availability
@inject IWorkspaceSession Session
@inject IReplaceCompositionHandler Compositions
@implements IAsyncDisposable

@if (Agent.IsConfigured && Availability.IsAvailable)
{
    <AuthorizeView Policy="@AiPolicy.Name">
        <Authorized>
            @* Replacing a workspace is the one destructive thing this page does, so it asks - and only when
               there is something to lose. An empty workspace applies without a dialog, because a
               confirmation that guards nothing is a step a customer learns to click through. *@
            <CompositionConfirmDialog @ref="confirmation"
                                      Message="@ReplaceMessage"
                                      OnConfirm="ApplyChosenAsync" />

            <section class="ai mb-section-gap rounded-2xl bg-surface-container-lowest p-stack-md shadow-ambient"
                     data-testid="ai-section"
                     data-expanded="@(Expanded ? "true" : "false")"
                     aria-labelledby="ai-heading">
                @* One line when idle: a field and a control. The prose around it appears only once there is
                   something to say, because an offer of help that fills the page before it is used is a
                   section a customer scrolls past. *@
                @if (Expanded)
                {
                    <h2 id="ai-heading" class="text-headline-md font-headline-md text-primary">Not sure where to start?</h2>
                    <p class="text-body-md font-body-md text-on-surface-variant mb-stack-sm">
                        Describe the workspace you need, and we will put options together.
                    </p>
                }

                @* Present from the first render and empty, because a live region added to the page at the same
                   moment as its first content is not reliably announced: the browser has to be observing the
                   element before it changes, and an element that arrives already full never changes at all.
                   It carries the application's own stage lines and the outcome that ends the run - and never
                   the model's prose, which would announce a field at a time over the whole run. *@
                <p class="sr-only" role="status" data-testid="ai-announcement">@announcement</p>

                @* Top-aligned, and each control's height comes from the stylesheet rather than from the row: a
                   control that stretched with the field would follow it down the page as a customer made it
                   taller, which is what they do when the sentence is long. *@
                <form class="ai__request flex flex-wrap items-start gap-2" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                    @* The field is the theme's own. `field` is what every other input in the application is
                       built from, and its textarea rule is already two lines tall - so this is a wrapper
                       rather than the same utilities written out again, and the AI section cannot drift
                       from the rest of the forms. *@
                    <div class="field flex-1 min-w-0">
                        <label class="sr-only" for="ai-query">Describe your workspace</label>
                        <textarea id="ai-query"
                                  rows="2"
                                  class="ai__query"
                                  data-testid="ai-query"
                                  placeholder="A desk, a chair and a monitor"
                                  disabled="@running"
                                  @ref="queryField"
                                  @bind="query"
                                  @bind:event="oninput"></textarea>
                    </div>

                    @* The theme's small button: a pill, carrying the application's own hover, disabled and
                       focus states rather than a second set invented here. *@
                    <button type="submit"
                            class="ai__submit button button--primary button--small"
                            data-testid="ai-submit"
                            disabled="@(running || string.IsNullOrWhiteSpace(query))">
                        Suggest
                    </button>

                    @if (running)
                    {
                        <button type="button"
                                class="ai__cancel button button--ghost button--small"
                                data-testid="ai-cancel"
                                @onclick="StopAsync">
                            Stop
                        </button>
                    }
                </form>

                @* The application's own words, written as each phase happens. They are not the agent's: its stage
                   identities never reach this application at all, so there is no vocabulary here to translate. *@
                @if (stages.Count > 0)
                {
                    @if (StagesCollapsed)
                    {
                        @* Retained and collapsed rather than removed, so a customer or a support engineer can
                           see where a slow or partly failed run went. *@
                        <button type="button"
                                class="ai__toggle mt-stack-sm underline"
                                data-testid="ai-stages-toggle"
                                aria-expanded="false"
                                @onclick="ExpandStages">
                            What took so long?
                        </button>
                    }
                    else
                    {
                        <ol class="ai__stages mt-stack-sm text-label-md font-label-md text-on-surface-variant"
                            data-testid="ai-stages">
                            @foreach (var stage in stages)
                            {
                                <li class="ai__stage" data-stage="@stage">@stage</li>
                            }
                        </ol>
                    }
                }

                @* The model's own words, each one written the moment its JSON string closed. Never its JSON, and
                   never a partial value: the reader emits a field only when it is complete, which is what lets
                   the strip run on a finished value. Not a live region, and deliberately no role at all - this
                   is commentary, and announcing it field by field would talk over the run. *@
                @if (narrative.Count > 0)
                {
                    <div class="ai__stream mt-stack-sm text-body-md font-body-md text-on-surface"
                         data-testid="ai-stream">
                        @foreach (var line in narrative)
                        {
                            <p class="ai__line">@line</p>
                        }
                    </div>
                }

                @* Kept and marked not applied rather than retracted mid-read. The text carries no price and no
                   product name, so leaving it on screen cannot mislead - and a customer who watched a run end
                   needs to know whether their workspace moved. It did not. *@
                @if (NotApplied)
                {
                    <p class="ai__not-applied mt-stack-sm text-label-md font-label-md text-on-surface-variant" data-testid="ai-not-applied">
                        Not applied to your workspace.
                    </p>
                }

                @if (failed is not null)
                {
                    <p class="alert mt-stack-sm" role="alert" data-testid="ai-failed">
                        This suggestion couldn't be completed. Nothing was applied.
                    </p>
                    <button type="button" class="ai__retry mt-2 underline" data-testid="ai-retry" @onclick="SubmitAsync">
                        Try again
                    </button>
                }

                @if (stopped)
                {
                    @* Neutral, because the customer chose to stop. Reported as an error it would be a scolding
                       for using the control that is there to be used. *@
                    <p class="mt-stack-sm" role="status" data-testid="ai-stopped">
                        Stopped. Nothing was applied.
                    </p>
                    <button type="button" class="ai__again mt-2 underline" data-testid="ai-start-again" @onclick="SubmitAsync">
                        Start again
                    </button>
                }

                @if (outcome is not null)
                {
                    <div class="ai__outcome mt-stack-sm" data-testid="ai-outcome" data-status="@outcome.Status">
                        @if (outcome.Status is SuggestionResultFrame.NotWorkspace)
                        {
                            @* A result rather than an error, and guided rather than repeatable: the same words
                               sent again produce the same refusal, so what helps is being told what would work. *@
                            <p class="alert" role="status" data-testid="ai-refused">
                                That doesn't look like a workspace request — try describing the room, the work, or a budget.
                            </p>
                        }
                        else
                        {
                            @* Everything shown here was checked against the catalogue before it was rendered:
                               the names and the amounts are the catalogue's, and a candidate that could not be
                               honoured failed the run instead. The app does not order or label them - they are
                               shown in the order the agent returned them. *@
                            <div class="ai__candidates" data-testid="ai-candidates">
                                @foreach (var candidate in outcome.Candidates)
                                {
                                    <article class="ai__option mb-stack-sm rounded-xl bg-surface-container-low p-stack-md"
                                             data-testid="ai-option">
                                        <header class="flex items-baseline justify-between gap-2">
                                            <span class="ai__total text-label-md font-label-md" data-testid="ai-total">
                                                @candidate.MonthlyTotal.ToString("C")<span class="text-on-surface-variant">/mo</span>
                                            </span>
                                        </header>

                                        <p class="text-body-md font-body-md">@candidate.Rationale</p>

                                        <ul class="ai__lines text-label-md font-label-md text-on-surface-variant">
                                            @foreach (var line in candidate.Lines)
                                            {
                                                <li class="ai__line" data-sku="@line.Sku">
                                                    @line.Quantity &times; @line.Name
                                                    <span class="ai__line-total">@line.LineTotal.ToString("C")</span>
                                                </li>
                                            }
                                        </ul>

                                        <button type="button"
                                                class="ai__apply mt-stack-sm underline"
                                                data-testid="ai-apply"
                                                @onclick="() => ChooseAsync(candidate)">
                                            Use this setup
                                        </button>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                }

                @if (applied is not null)
                {
                    <p class="mt-stack-sm" role="status" data-testid="ai-applied">@applied</p>
                }

                @if (applyFailed is not null)
                {
                    @* A workspace that moved underneath the suggestion: nothing was applied, and the customer is
                       told rather than left looking at a setup that is not theirs. *@
                    <p class="alert mt-stack-sm" role="alert" data-testid="ai-apply-refused">@applyFailed</p>
                }
            </section>
        </Authorized>
    </AuthorizeView>
}

@code {
    private readonly List<string> stages = [];
    private readonly List<string> narrative = [];

    private string query = string.Empty;
    private string announcement = string.Empty;
    private SuggestionResultFrame? outcome;
    private string? failed;
    private bool stopped;
    private bool running;
    private bool collapsed;
    private CompositionConfirmDialog? confirmation;
    private SuggestionCandidate? pending;
    private string? applied;
    private string? applyFailed;
    private ElementReference queryField;
    private IJSObjectReference? module;
    private DotNetObjectReference<AiBuilderSection>? self;

    /// <summary>The draft this section will replace. Cascaded from the page, as every other component's is.</summary>
    [CascadingParameter(Name = "DraftToken")] private string? DraftToken { get; set; }

    /// <summary>Whether there is anything to show beyond the field: a run in flight, or a result of one.</summary>
    private bool Expanded
        => running || outcome is not null || failed is not null || stopped;

    /// <summary>Shown collapsed once a run has ended, and open while one is going.</summary>
    private bool StagesCollapsed => collapsed && !running;

    /// <summary>Whether streamed text is on screen with nothing applied to the workspace.</summary>
    private bool NotApplied => (failed is not null || stopped) && narrative.Count > 0;

    private async Task SubmitAsync()
    {
        if (running || string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        Start();

        self ??= DotNetObjectReference.Create(this);
        module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/ai-run.js");

        await module.InvokeVoidAsync("start", self, query);
    }

    private async Task StopAsync()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("stop");
        }
    }

    /// <summary>Hands the field's Enter key to the component, once the field is on the page.</summary>
    /// <remarks>
    /// A textarea inserts a newline for Enter by itself, and nothing in the markup can tell that key from
    /// Shift+Enter - so the browser is asked to stop instead and the component is told. This is what the field
    /// did when it was a single line, and it is the key a customer reaches for after typing a sentence.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        self ??= DotNetObjectReference.Create(this);
        module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/ai-run.js");

        await module.InvokeVoidAsync("submitOnEnter", queryField, self);
    }

    /// <summary>The customer pressed Enter in the field. Sends, exactly as the button does.</summary>
    [JSInvokable]
    public Task SubmittedFromKeyboard() => SubmitAsync();

    /// <summary>One frame of the run: a stage, a piece of the model's words, the answer, or a failure.</summary>
    [JSInvokable]
    public Task Frame(string name, string data)
    {
        switch (name)
        {
            case "stage":
                stages.Add(data);

                // The stage lines are what a screen reader hears while a run is going, because they are short
                // and the application wrote them. The prose never goes through here.
                announcement = data;
                break;

            case "text":
                narrative.Add(data);
                break;

            case "result":
                outcome = Read(data);

                // The candidates ARE the terminal outcome, so this says they have arrived rather than reading
                // them out one line at a time.
                announcement = outcome?.Status is SuggestionResultFrame.NotWorkspace
                    ? "That doesn't look like a workspace request."
                    : "Your workspace suggestions are ready.";

                Finish();
                break;

            case "failed":
                // A code, not a sentence: the words belong here, and the agent's own reason is diagnostic.
                failed = data;
                Finish();
                break;
        }

        StateHasChanged();

        return Task.CompletedTask;
    }

    /// <summary>The customer stopped, or went away. Neutral, and nothing was applied.</summary>
    [JSInvokable]
    public Task Stopped()
    {
        stopped = true;
        Finish();
        StateHasChanged();

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task Broke(string message)
    {
        failed = message;
        Finish();
        StateHasChanged();

        return Task.CompletedTask;
    }

    /// <summary>Refused before anything was streamed: no permission, a run in flight, or an empty request.</summary>
    [JSInvokable]
    public Task Refused(int status)
    {
        failed = $"refused:{status}";
        Finish();
        StateHasChanged();

        return Task.CompletedTask;
    }

    /// <summary>The stream ended without an answer. A run, not a guess.</summary>
    [JSInvokable]
    public Task Ended()
    {
        if (running)
        {
            failed = "ended";
            Finish();
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private void Start()
    {
        stages.Clear();
        narrative.Clear();
        outcome = null;
        failed = null;
        stopped = false;
        collapsed = false;
        announcement = string.Empty;
        applied = null;
        applyFailed = null;
        pending = null;
        running = true;
    }

    private void Finish()
    {
        running = false;

        // Retained, and collapsed: where a run went is worth being able to see afterwards, and worth not
        // having to look at once it is over.
        collapsed = true;
    }

    private void ExpandStages() => collapsed = false;

    /// <summary>What the confirmation says, in the application's words, naming what will be lost.</summary>
    /// <remarks>
    /// It names the count rather than saying "your workspace", and it says what is NOT changed, because the
    /// fear a customer has at this moment is that replacing the setup will also lose their address.
    /// </remarks>
    private string ReplaceMessage
    {
        get
        {
            var units = Session.Current?.TotalUnits ?? 0;

            return units == 1
                ? "This replaces the item you have already picked. Your delivery address is not changed."
                : $"This replaces the {units} items you have already picked. Your delivery address is not changed.";
        }
    }

    /// <summary>Choosing a candidate: ask first when there is something to lose, and apply when there is not.</summary>
    /// <remarks>
    /// The choice is held in <c>pending</c> and is DELIBERATELY not cleared when the dialog closes - because the
    /// dialog closes itself before it reports a confirmation. Clearing on close looked exactly like a button
    /// that did nothing at all, which is what it was.
    /// </remarks>
    private async Task ChooseAsync(SuggestionCandidate candidate)
    {
        ArgumentNullException.ThrowIfNull(candidate);

        pending = candidate;
        applied = null;
        applyFailed = null;

        if (Session.IsEmpty)
        {
            await ApplyChosenAsync();
            return;
        }

        if (confirmation is not null)
        {
            await confirmation.ShowAsync();
        }
    }

    /// <summary>
    /// Writes the chosen composition over the draft, and re-reads it.
    /// </summary>
    /// <remarks>
    /// The version the page is rendering is what travels with the write, so a workspace that moved since - in
    /// another tab, or while the suggestion was being drawn - is refused by the module rather than merged. A
    /// refusal is shown rather than swallowed: the customer is looking at a suggestion that is no longer based
    /// on what they have, and that is worth knowing.
    /// </remarks>
    private async Task ApplyChosenAsync()
    {
        if (pending is null || string.IsNullOrEmpty(DraftToken) || Session.Current is null)
        {
            return;
        }

        var lines = pending.Lines
            .Select(line => new ReplaceCompositionLine(line.Slot, line.Sku, line.Quantity))
            .ToArray();

        try
        {
            await Compositions.HandleAsync(new ReplaceCompositionCommand(
                DraftToken,
                Session.Current.Version,
                lines));

            await Session.RefreshAsync(DraftToken);

            applied = "Applied your chosen setup. Your workspace has been replaced.";
            pending = null;
        }
        catch (DomainRuleViolationException refusal)
        {
            applyFailed = refusal.Message;
        }

        StateHasChanged();
    }

    /// <summary>Reads the frame, and treats one it cannot read as a failure rather than as a broken circuit.</summary>
    private static SuggestionResultFrame? Read(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<SuggestionResultFrame>(json, SuggestionJson.Options);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone; there is nothing to release.
            }
        }

        self?.Dispose();
    }
}
