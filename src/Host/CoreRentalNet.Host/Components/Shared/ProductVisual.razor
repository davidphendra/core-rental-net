@* The product's image, or the deliberate placeholder drawn when no file exists. It renders no
   wrapper: the caller owns the box, its hover, and anything else it puts inside it - a card's
   "Popular" badge, for instance.

   That one decision - image, or glyph when there is no file - is the whole of it, and it is the
   reason the component exists: five surfaces used to make it for themselves, and a change to the
   placeholder had five places to reach. *@
@if (ImageAvailable && !string.IsNullOrWhiteSpace(ImagePath))
{
    <img class="@ImageClass" src="@ImagePath" alt="@AltText" loading="lazy" />
}
else
{
    <svg class="@GlyphClass" viewBox="0 0 24 24" role="img" aria-label="@AltText" focusable="false"
         fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="@ProductGlyph.PathFor(Glyph)" />
    </svg>
}

@code {
    [Parameter, EditorRequired] public string AltText { get; set; } = string.Empty;

    [Parameter] public string? ImagePath { get; set; }

    [Parameter] public bool ImageAvailable { get; set; }

    [Parameter] public string Glyph { get; set; } = "beanbag";

    /// <summary>Classes for the image. The two kinds are laid out differently, so each states its own.</summary>
    [Parameter] public string ImageClass { get; set; } = string.Empty;

    /// <summary>Classes for the placeholder glyph.</summary>
    [Parameter] public string GlyphClass { get; set; } = string.Empty;
}
