@* The one place a price is drawn. The symbol, the group separator and the number of decimals are
   the configured culture's (see BusinessCultureExtentions), so nothing here names "Rp" or a culture. *@
<span class="price-tag label-md">
    <strong>@Value.Amount.ToString("C")</strong><span class="muted">/mo</span>
</span>

@code {
    [Parameter, EditorRequired] public Money Value { get; set; }
}
