@inject GetCatalogPageHandler CatalogPage
@* Opens already filtered to the slot that was clicked, so the choice is always valid.

   The query to ask arrives as an argument to ShowAsync rather than as a parameter, because a
   parameter is not there yet when it is needed: Blazor applies a child's parameters when the parent
   re-renders, which happens after the handler that set them has returned. As a parameter this read
   the previous request and offered the whole catalog.

   It asks the catalog itself, once when it opens and once per keystroke, so the search is a query
   rather than a filter over a list the page happened to hand it. What the slot accepts arrives as
   the query to ask, which is why the same component serves a slot's own kind of thing and, on a
   phone, a whole category.

   Its search belongs to it alone: it narrows what this dialog is showing and knows nothing about the
   panel's search, which narrows the panel, and each empties at its own moment.

   Products are grouped by subcategory only when they span more than one, which is the phone case.
   The design's dialog had a 60vh cap on this list, in a scoped stylesheet this application never
   loads, so nothing capped it: ten candidates stood taller than the window. *@
<ModalDialog @ref="dialog" Title="@Title" OnClosed="HandleClosedAsync">
    <ChildContent>
        <div class="field">
            <label class="sr-only" for="picker-search">Search these products by name</label>
            <input id="picker-search" type="search" autocomplete="off" placeholder="Search by name"
                   value="@query" @oninput="OnQueryChanged" />
        </div>

        @if (products.Count == 0)
        {
            <p class="body-md muted">@EmptyMessage</p>
        }
        else
        {
            <div class="picker max-h-[60vh] overflow-y-auto flex flex-col gap-stack-lg pr-1">
                @foreach (var group in Groups)
                {
                    <section class="flex flex-col gap-3">
                        @if (ShowHeadings && group.Label.Length > 0)
                        {
                            <h3 class="text-label-md font-label-md text-on-surface-variant uppercase tracking-wider">@group.Label</h3>
                        }
                        <div class="grid grid-cols-2 gap-3">
                            @foreach (var product in group.Products)
                            {
                                var candidate = product;
                                <BuilderProductCard Product="candidate" OnSelect="() => PickAsync(candidate)" />
                            }
                        </div>
                    </section>
                }
            </div>
        }
    </ChildContent>
    <Actions>
        <button type="button" class="button button--ghost" @onclick="CloseAsync">Cancel</button>
    </Actions>
</ModalDialog>

@code {
    private ModalDialog? dialog;
    private IReadOnlyList<ProductListItem> products = [];
    private GetCatalogPage request = new();
    private string query = string.Empty;

    [Parameter, EditorRequired] public string Title { get; set; } = "Choose an item";

    [Parameter] public EventCallback<ProductListItem> OnPick { get; set; }

    [Parameter] public EventCallback OnDismissed { get; set; }

    /// <summary>What the catalog answered, in its subcategories.</summary>
    private IReadOnlyList<CatalogGroup> Groups => AccessoryGroups.Of(products);

    /// <summary>
    /// Headings only where there is more than one kind of thing to tell apart. A slot's own picker
    /// holds one subcategory, so it draws none; the category chips on a phone open this same dialog
    /// with a whole category in it, and that is where a heading earns its place.
    /// </summary>
    private bool ShowHeadings => Groups.Count > 1;

    private string EmptyMessage => string.IsNullOrWhiteSpace(query)
        ? "Nothing in the catalog fits this slot."
        : $"Nothing here is named \"{query.Trim()}\".";

    /// <summary>
    /// Opens on what the slot accepts, with an empty search, so a second visit does not inherit the
    /// first one's.
    /// </summary>
    public Task ShowAsync(GetCatalogPage query)
    {
        ArgumentNullException.ThrowIfNull(query);

        request = query;
        this.query = string.Empty;
        Load();

        return dialog?.ShowAsync() ?? Task.CompletedTask;
    }

    public Task CloseAsync() => dialog?.CloseAsync() ?? Task.CompletedTask;

    private void OnQueryChanged(ChangeEventArgs args)
    {
        query = args.Value?.ToString() ?? string.Empty;
        Load();
    }

    private void Load() => products = CatalogPage.Handle(request with { Search = query });

    private async Task PickAsync(ProductListItem product)
    {
        await OnPick.InvokeAsync(product);
        await CloseAsync();
    }

    private Task HandleClosedAsync() => OnDismissed.InvokeAsync();
}
