@* The panel's category tabs. The design stacks these down the sidebar with their names beside the
   icons; this is the arrangement asked for instead, so it is a deliberate difference: one row
   across the top of the panel, icons only, desks first. The palette, the shape and the active
   state are still the design's. Each tab keeps its name as the accessible name, so it is still
   announced as "Desks" and can still be found by that name. *@
<nav class="flex gap-2" aria-label="Product categories">
    @foreach (var tab in CatalogTabs.All)
    {
        var current = tab;
        <button type="button" class="@PlacementFor(current)"
                aria-pressed="@((Selected == current).ToString().ToLowerInvariant())"
                aria-label="@CatalogTabs.LabelFor(current)"
                title="@CatalogTabs.LabelFor(current)"
                @onclick="() => OnSelect.InvokeAsync(current)">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="@ProductGlyph.PathFor(CatalogTabs.GlyphFor(current))" />
            </svg>
        </button>
    }
</nav>

@code {
    [Parameter, EditorRequired] public CatalogTab Selected { get; set; }

    [Parameter] public EventCallback<CatalogTab> OnSelect { get; set; }

    private string PlacementFor(CatalogTab tab) => Selected == tab
        ? "bg-primary-container text-on-primary-container rounded-xl flex items-center justify-center p-3 scale-95 transition-transform duration-150"
        : "text-on-surface-variant hover:bg-surface-variant rounded-xl flex items-center justify-center p-3 hover:bg-secondary-container transition-colors";
}
