@* The zones that sit below the stage, in the design's four-column grid. Only zones the catalog
   can actually fill are rendered. *@
<div class="zone-list mt-section-gap grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter max-w-4xl mx-auto">
    @foreach (var slot in View.Slots.Where(slot => ZoneIds.Contains(slot.Slot)))
    {
        <section class="flex flex-col items-center">
            <h3 class="text-label-md font-label-md text-on-surface bg-surface-container-highest px-4 py-1 rounded-full mb-4">@slot.DisplayName</h3>
            <SlotView Slot="slot" Position="w-full h-24" OnPick="OnPick" OnRemove="OnRemove" OnQuantityChange="OnQuantityChange" />
        </section>
    }
</div>

@code {
    private static readonly SlotId[] ZoneIds = [SlotId.CoffeeStation, SlotId.RelaxZone];

    [Parameter, EditorRequired] public WorkspaceView View { get; set; } = default!;

    [Parameter] public EventCallback<SlotId> OnPick { get; set; }

    [Parameter] public EventCallback<SlotId> OnRemove { get; set; }

    [Parameter] public EventCallback<(SlotId Slot, int Quantity)> OnQuantityChange { get; set; }
}
