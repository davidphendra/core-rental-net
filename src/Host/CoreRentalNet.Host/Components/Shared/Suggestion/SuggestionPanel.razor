@* The suggestion panel: ask for a suggestion, read the run as it happens, and stop it if it takes too long.

   Gated twice, and the gates answer different questions. `MicrosoftFoundryAgentConnectionSettings` says whether
   this deployment has an agent at all, so a deployment without one looks exactly as it did before the feature
   existed. The permission says whether this customer may spend. Neither is authorisation on its own: the
   endpoint checks the permission for itself, because a panel that is not rendered is presentation rather than a
   gate.

   The panel accumulates nothing. Each frame is handed to `SuggestionFrameProcessor`, which owns the state, and
   the markup renders whatever `SuggestionPanelState.BuildNotices` yields. *@
@using CoreRentalNet.Modules.Workspace.Application.Commands.ReplaceComposition
@using CoreRentalNet.Modules.Workspace.Infrastructure.Suggestions
@using Microsoft.AspNetCore.Http
@inject IJSRuntime JavaScript
@inject MicrosoftFoundryAgentConnectionSettings Agent
@inject WorkspaceSuggestionAvailability Availability
@inject IWorkspaceSession Session
@inject IReplaceCompositionHandler Compositions
@implements IAsyncDisposable

@if (Agent.IsConfigured && Availability.IsAvailable)
{
    <AuthorizeView Policy="@WorkspaceSuggestionPolicy.Name">
        <Authorized>
            @* Replacing a workspace is the one destructive thing this page does, so it asks - and only when
               there is something to lose. An empty workspace applies without a dialog, because a confirmation
               that guards nothing is a step a customer learns to click through. *@
            <CompositionConfirmDialog @ref="confirmation"
                                      Message="@ReplaceMessage"
                                      OnConfirm="ApplyChosenAsync" />

            <section class="ai mb-section-gap rounded-2xl bg-surface-container-lowest p-stack-md shadow-ambient"
                     data-testid="suggestion-panel"
                     data-expanded="@(panelState.IsExpanded ? "true" : "false")"
                     aria-labelledby="ai-heading">
                @* One line when idle: a field and a control. The prose around it appears only once there is
                   something to say, because an offer of help that fills the page before it is used is a panel a
                   customer scrolls past. *@
                @if (panelState.IsExpanded)
                {
                    <h2 id="ai-heading" class="text-headline-md font-headline-md text-primary">Not sure where to start?</h2>
                    <p class="text-body-md font-body-md text-on-surface-variant mb-stack-sm">
                        Describe the workspace you need, and we will put options together.
                    </p>
                }

                @* Present from the first render and empty, because a live region added to the page at the same
                   moment as its first content is not reliably announced: the browser has to be observing the
                   element before it changes, and an element that arrives already full never changes at all. It
                   carries the application's own stage lines and the outcome that ends the run - and never the
                   model's prose, which would announce a field at a time over the whole run. *@
                <p class="sr-only" role="status" data-testid="suggestion-announcement">@announcement</p>

                @* Top-aligned, and each control's height comes from the stylesheet rather than from the row: a
                   control that stretched with the field would follow it down the page as a customer made it
                   taller, which is what they do when the sentence is long. *@
                <form class="ai__request flex flex-wrap items-start gap-2" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                    @* The field is the theme's own. `field` is what every other input in the application is built
                       from, and its textarea rule is already two lines tall - so this is a wrapper rather than
                       the same utilities written out again. *@
                    <div class="field flex-1 min-w-0">
                        <label class="sr-only" for="ai-query">Describe your workspace</label>
                        <textarea id="ai-query"
                                  rows="2"
                                  class="ai__query"
                                  data-testid="suggestion-query"
                                  placeholder="A desk, a chair and a monitor"
                                  disabled="@panelState.IsRunning"
                                  @ref="queryField"
                                  @bind="query"
                                  @bind:event="oninput"></textarea>
                    </div>

                    @* The theme's small button: a pill, carrying the application's own hover, disabled and focus
                       states rather than a second set invented here. *@
                    <button type="submit"
                            class="ai__submit button button--primary button--small"
                            data-testid="suggestion-submit"
                            disabled="@(panelState.IsRunning || string.IsNullOrWhiteSpace(query))">
                        Suggest
                    </button>

                    @if (panelState.IsRunning)
                    {
                        <button type="button"
                                class="ai__cancel button button--ghost button--small"
                                data-testid="suggestion-cancel"
                                @onclick="StopAsync">
                            Stop
                        </button>
                    }
                </form>

                <SuggestionNoticeList Notices="@panelState.BuildNotices()"
                                      OnExpandStages="panelState.ExpandStages"
                                      OnRetry="SubmitAsync"
                                      OnCandidateChosen="ChooseAsync" />

                @if (applied is not null)
                {
                    <p class="mt-stack-sm" role="status" data-testid="suggestion-applied">@applied</p>
                }

                @if (applyFailed is not null)
                {
                    @* A workspace that moved underneath the suggestion: nothing was applied, and the customer is
                       told rather than left looking at a setup that is not theirs. *@
                    <p class="alert mt-stack-sm" role="alert" data-testid="suggestion-apply-refused">@applyFailed</p>
                }
            </section>
        </Authorized>
    </AuthorizeView>
}

@code {
    private readonly SuggestionPanelState panelState = new();

    private SuggestionFrameProcessor suggestionFrameProcessor = null!;
    private string query = string.Empty;
    private string announcement = string.Empty;
    private CompositionConfirmDialog? confirmation;
    private WorkspaceSuggestionCandidate? pending;
    private string? applied;
    private string? applyFailed;
    private ElementReference queryField;
    private IJSObjectReference? module;
    private DotNetObjectReference<SuggestionPanel>? self;

    /// <summary>The draft this panel will replace. Cascaded from the page, as every other component's is.</summary>
    [CascadingParameter(Name = "DraftToken")] private string? DraftToken { get; set; }

    /// <summary>The processor holds the panel's state, and is created with the panel so nothing leaks between panels.</summary>
    protected override void OnInitialized()
        => suggestionFrameProcessor = new SuggestionFrameProcessor(panelState);

    private async Task SubmitAsync()
    {
        if (panelState.IsRunning || string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        panelState.BeginSuggestionRun();
        announcement = string.Empty;
        applied = null;
        applyFailed = null;
        pending = null;

        self ??= DotNetObjectReference.Create(this);
        module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/ai-run.js");

        await module.InvokeVoidAsync("start", self, query);
    }

    private async Task StopAsync()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("stop");
        }
    }

    /// <summary>Hands the field's Enter key to the component, once the field is on the page.</summary>
    /// <remarks>
    /// A textarea inserts a newline for Enter by itself, and nothing in the markup can tell that key from
    /// Shift+Enter - so the browser is asked to stop instead and the component is told. This is what the field
    /// did when it was a single line, and it is the key a customer reaches for after typing a sentence.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        self ??= DotNetObjectReference.Create(this);
        module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/ai-run.js");

        await module.InvokeVoidAsync("submitOnEnter", queryField, self);

        // Ask the server once whether this session can still produce a catalogue token, so a session that has
        // ended is said before a run is attempted rather than as a failed run. The probe is advisory: the run
        // endpoint itself refuses a session that cannot produce one.
        await module.InvokeVoidAsync("sessionStatus", self);
    }

    /// <summary>The customer pressed Enter in the field. Sends, exactly as the button does.</summary>
    [JSInvokable]
    public Task SubmittedFromKeyboard() => SubmitAsync();

    /// <summary>One frame of the run, handed to the processor; the component holds no run state of its own.</summary>
    [JSInvokable]
    public Task Frame(string name, string data)
    {
        announcement = suggestionFrameProcessor.ProcessServerSentEvent(name, data) ?? announcement;

        StateHasChanged();

        return Task.CompletedTask;
    }

    /// <summary>The customer stopped, or went away. Neutral, and nothing was applied.</summary>
    [JSInvokable]
    public Task Stopped()
    {
        panelState.MarkStopped();
        StateHasChanged();

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task Broke(string message)
    {
        panelState.FailWithCode(message);
        StateHasChanged();

        return Task.CompletedTask;
    }

    /// <summary>The code a refusal the session caused is drawn under, rather than a generic failure.</summary>
    private const string ExpiredSessionCode = "session-expired";

    /// <summary>Refused before anything was streamed: an expired session, no permission, a run in flight, or an
    /// empty request.</summary>
    [JSInvokable]
    public Task Refused(int status)
    {
        panelState.FailWithCode(status == StatusCodes.Status401Unauthorized
            ? ExpiredSessionCode
            : $"refused:{status}");

        StateHasChanged();

        return Task.CompletedTask;
    }

    /// <summary>The server's answer to whether this session can still produce a catalogue token.</summary>
    /// <remarks>
    /// Advisory only: a session that cannot produce one is said here so the customer is told before they type,
    /// and the run endpoint refuses it anyway. A probe that arrives while a run is in flight is ignored, because
    /// the run owns the panel's state at that point.
    /// </remarks>
    [JSInvokable]
    public Task SessionChecked(bool canRun)
    {
        if (canRun || panelState.IsRunning)
        {
            return Task.CompletedTask;
        }

        panelState.FailWithCode(ExpiredSessionCode);
        StateHasChanged();

        return Task.CompletedTask;
    }

    /// <summary>The stream ended without an answer. A run, not a guess.</summary>
    [JSInvokable]
    public Task Ended()
    {
        if (panelState.IsRunning)
        {
            panelState.FailWithCode("ended");
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    /// <summary>What the confirmation says, in the application's words, naming what will be lost.</summary>
    /// <remarks>
    /// It names the count rather than saying "your workspace", and it says what is NOT changed, because the
    /// fear a customer has at this moment is that replacing the setup will also lose their address.
    /// </remarks>
    private string ReplaceMessage
    {
        get
        {
            var units = Session.Current?.TotalUnits ?? 0;

            return units == 1
                ? "This replaces the item you have already picked. Your delivery address is not changed."
                : $"This replaces the {units} items you have already picked. Your delivery address is not changed.";
        }
    }

    /// <summary>Choosing a candidate: ask first when there is something to lose, and apply when there is not.</summary>
    /// <remarks>
    /// The choice is held in <c>pending</c> and is DELIBERATELY not cleared when the dialog closes - because the
    /// dialog closes itself before it reports a confirmation. Clearing on close looked exactly like a button
    /// that did nothing at all, which is what it was.
    /// </remarks>
    private async Task ChooseAsync(WorkspaceSuggestionCandidate candidate)
    {
        ArgumentNullException.ThrowIfNull(candidate);

        pending = candidate;
        applied = null;
        applyFailed = null;

        if (Session.IsEmpty)
        {
            await ApplyChosenAsync();
            return;
        }

        if (confirmation is not null)
        {
            await confirmation.ShowAsync();
        }
    }

    /// <summary>
    /// Writes the chosen composition over the draft, and re-reads it.
    /// </summary>
    /// <remarks>
    /// The version the page is rendering is what travels with the write, so a workspace that moved since - in
    /// another tab, or while the suggestion was being drawn - is refused by the module rather than merged. A
    /// refusal is shown rather than swallowed: the customer is looking at a suggestion that is no longer based
    /// on what they have, and that is worth knowing.
    /// </remarks>
    private async Task ApplyChosenAsync()
    {
        if (pending is null || string.IsNullOrEmpty(DraftToken) || Session.Current is null)
        {
            return;
        }

        var lines = pending.Lines
            .Select(line => new ReplaceCompositionLine(line.Slot, line.Sku, line.Quantity))
            .ToArray();

        try
        {
            await Compositions.HandleAsync(new ReplaceCompositionCommand(
                DraftToken,
                Session.Current.Version,
                lines));

            await Session.RefreshAsync(DraftToken);

            applied = "Applied your chosen setup. Your workspace has been replaced.";
            pending = null;
        }
        catch (DomainRuleViolationException refusal)
        {
            applyFailed = refusal.Message;
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone; there is nothing to release.
            }
        }

        self?.Dispose();
    }
}
