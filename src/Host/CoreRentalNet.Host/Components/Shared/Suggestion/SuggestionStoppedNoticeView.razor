@if (Model.NotApplied)
{
    <p class="ai__not-applied mt-stack-sm text-label-md font-label-md text-on-surface-variant" data-testid="suggestion-not-applied">
        Not applied to your workspace.
    </p>
}

@* Neutral, because the customer chose to stop. Reported as an error it would be a scolding for using the
   control that is there to be used. *@
<p class="mt-stack-sm" role="status" data-testid="suggestion-stopped">
    Stopped. Nothing was applied.
</p>
<button type="button" class="ai__again mt-2 underline" data-testid="suggestion-start-again" @onclick="OnRetry">
    Start again
</button>

@code {
    [Parameter, EditorRequired] public required SuggestionNotice Notice { get; set; }

    [Parameter] public EventCallback OnExpandStages { get; set; }

    [Parameter] public EventCallback OnRetry { get; set; }

    [Parameter] public EventCallback<WorkspaceSuggestionCandidate> OnCandidateChosen { get; set; }

    private SuggestionStoppedNotice Model => (SuggestionStoppedNotice)Notice;
}
