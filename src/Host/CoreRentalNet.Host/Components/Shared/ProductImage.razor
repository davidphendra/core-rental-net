@* A product image, or a deliberate placeholder when no image file exists, in the framed box the
   design gives it. The choice between the two belongs to ProductVisual; this is only the box, so a
   caller that draws its own box (a store or builder card) uses ProductVisual directly. *@
<div class="product-image @CssClass">
    <ProductVisual AltText="@AltText" ImagePath="@ImagePath" ImageAvailable="@ImageAvailable"
                  Glyph="@Glyph" GlyphClass="product-image__glyph" />
</div>

@code {
    [Parameter, EditorRequired] public string AltText { get; set; } = string.Empty;

    [Parameter] public string? ImagePath { get; set; }

    [Parameter] public bool ImageAvailable { get; set; }

    [Parameter] public string Glyph { get; set; } = "beanbag";

    [Parameter] public string? CssClass { get; set; }
}
