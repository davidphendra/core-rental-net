@* The stage, and the seven positions the design draws on it.

   The design is a picture of one workspace - a table, a chair, an empty place for a monitor, a
   lamp and a plant - so the positions are fixed rather than computed. What is not fixed is what
   stands in them: this renders whatever the workspace actually holds. The zones that sit below
   the stage are ZoneList's, not this component's. *@
<div class="workspace-stage relative w-full max-w-4xl mx-auto h-[500px] bg-surface-bright rounded-[2rem] shadow-ambient border border-surface-container-high p-8 flex flex-col items-center justify-center overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#006767 1px, transparent 1px); background-size: 24px 24px;"></div>

    <div class="scene relative w-full max-w-2xl h-64 flex flex-col items-center justify-end z-10">
        @foreach (var slot in SceneSlots(AccessorySlots))
        {
            <SlotView Slot="slot" Position="@SlotCss.StagePositionFor(slot.Slot)" OnPick="OnPick"
                      OnRemove="OnRemove" OnQuantityChange="OnQuantityChange" ReadOnly="ReadOnly" />
        }

        @foreach (var slot in SceneSlots(BelowBarSlots))
        {
            <SlotView Slot="slot" Position="@SlotCss.StagePositionFor(slot.Slot)" OnPick="OnPick"
                      OnRemove="OnRemove" OnQuantityChange="OnQuantityChange" ReadOnly="ReadOnly" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public WorkspaceView View { get; set; } = default!;

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public EventCallback<SlotId> OnPick { get; set; }

    [Parameter] public EventCallback<SlotId> OnRemove { get; set; }

    [Parameter] public EventCallback<(SlotId Slot, int Quantity)> OnQuantityChange { get; set; }

    /// <summary>Above and beside the desk. Enumerated as data so a slot cannot be forgotten.</summary>
    private static readonly SlotId[] AccessorySlots = [SlotId.Monitor, SlotId.Lamp, SlotId.Plant];

    /// <summary>The desk itself rests on the bar, with the chair in front of it.</summary>
    private static readonly SlotId[] BelowBarSlots = [SlotId.Desk, SlotId.Chair];

    private IEnumerable<AssignableSlot> SceneSlots(params SlotId[] slots)
        => slots.Select(SlotOf);

    private AssignableSlot SlotOf(SlotId slot)
        => View.Slots.First(candidate => candidate.Slot == slot);
}
