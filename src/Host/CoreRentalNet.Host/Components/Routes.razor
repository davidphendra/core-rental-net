@* The authorization state is published for everything below, because the router enforces the page's
   [Authorize] itself: an interactive circuit navigates without leaving the page, so it never reaches
   the middleware that answers a first request, and the policy would have a hole in it exactly where a
   customer moves around the application. *@
<CascadingAuthenticationState>
<CascadingValue Name="Customer" Value="Customer">
<CascadingValue Name="DraftToken" Value="DraftToken">
<CascadingValue Name="StoreCategory" Value="StoreCategory">
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MarketingLayout)">
            @* Two different people, and one answer for each: a guest is sent to sign in, and an
               account that is already signed in but not entitled is told so. Sending the second one to
               sign in would be a loop, since signing in again changes nothing about the claim. *@
            <NotAuthorized>
                <LayoutView Layout="typeof(MarketingLayout)">
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <AccessRefused />
                    }
                    else
                    {
                        <SignInRedirect />
                    }
                </LayoutView>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MarketingLayout)">
            <div class="container section stack-md">
                <h1 class="headline-lg">Nothing here</h1>
                <p class="body-lg muted">That address does not exist in this demo.</p>
                <a class="button button--primary" href="/">Back to the home page</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
</CascadingValue>
</CascadingValue>
</CascadingValue>
</CascadingAuthenticationState>

@code {
    /// <summary>
    /// Passed in from the root component as a parameter, which survives the jump into the
    /// interactive circuit, and re-published here for everything below it.
    /// </summary>
    [Parameter] public string? DraftToken { get; set; }

    /// <summary>Published beside the draft token, for the same reason and by the same mechanism.</summary>
    [Parameter] public CurrentCustomer Customer { get; set; } = CurrentCustomer.Anonymous;

    /// <summary>The store's remembered category, desks when nothing was remembered.</summary>
    [Parameter] public CatalogTab StoreCategory { get; set; } = CatalogTab.Desks;
}
