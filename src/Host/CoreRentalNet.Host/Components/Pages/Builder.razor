@page "/builder"
@layout BuilderLayout
@attribute [Authorize(Policy = CatalogPolicy.Name)]
@inherits WorkspaceObserver
@inject ISearchCatalogHandler CatalogSearch
@inject NavigationManager Navigation
<PageTitle>Workspace Builder — Core Rental</PageTitle>

<SelectionPanel />

<section class="flex-1 min-w-0 lg:ml-80 w-full px-margin-mobile lg:px-margin-desktop py-stack-lg pb-32">
    <div class="text-center mb-section-gap">
        <h1 class="text-headline-lg-mobile lg:text-display-lg font-display-lg text-primary mb-2">Design Your Workspace!</h1>
        <p class="text-body-lg font-body-lg text-outline">Create Your Perfect Setup</p>
    </div>

    @if (EmptyNotice)
    {
        <p class="alert alert--info" role="status">Add an item to your workspace before reviewing it.</p>
    }

    @if (Session.Error is not null)
    {
        <p class="alert" role="alert">@Session.Error</p>
    }

    @if (SelectionError is not null)
    {
        <p class="alert" role="alert">@SelectionError</p>
    }

    @if (Session.Current is not null)
    {
        @* The stage and the zones are siblings in the design, and they stay siblings here. Wrapping
           them in a flex column looks harmless and is not: an auto margin on the cross axis cancels
           the stretch, so the zone grid is sized by its content (608px instead of the 880 it has),
           and the wrapper's own gap is added on top of the design's section spacing. *@
        <SlotCanvas View="Session.Current" OnPick="OpenPickerAsync" OnRemoveItem="RemoveItemAsync" />
        <ZoneList View="Session.Current" OnPick="OpenPickerAsync" OnRemoveItem="RemoveItemAsync" />
    }

    @* The docked panel is not on screen on a phone, so the categories become a row of chips that
       open the picker already filtered, which is the same thing the panel does on a desktop. *@
    <CategoryChips Selected="mobileTab" OnSelect="OpenCategoryAsync" />

    @* Gated by its own permission inside the component, so the page does not have to know whether
       this deployment offers suggestions at all. *@
    <AiBuilderSection />
</section>

@if (Session.Current is not null)
{
    @* No wrapper: the bar positions itself, the way the design draws it. *@
    <MonthlyTotalBar View="Session.Current" OnReady="GoToReviewAsync" />
}

<SlotPickerDialog @ref="picker" Title="@pickerTitle" OnPick="AssignAsync" />

@code {
    [CascadingParameter(Name = "DraftToken")] public string? DraftToken { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "empty")] public bool EmptyNotice { get; set; }

    private SlotPickerDialog? picker;
    private string pickerTitle = "Choose an item";
    private string? SelectionError;
    private CatalogTab mobileTab = CatalogTab.Desks;

    private bool CanCheckout => Session.Current?.CanCheckout ?? false;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(DraftToken))
        {
            await Session.EnsureLoadedAsync(DraftToken);
        }

    }

    /// <summary>What a phone gets instead of the panel: the category's products, to pick from.</summary>
    private async Task OpenCategoryAsync(CatalogTab selected)
    {
        SelectionError = null;
        mobileTab = selected;

        var request = new SearchCatalogQuery(Category: CatalogTabs.CategoryFor(selected));
        pickerTitle = CatalogTabs.LabelFor(selected);

        if (picker is null)
        {
            return;
        }

        // Asked here as well, so that a category with nothing in it can be said out loud; the picker
        // asks again itself, once per keystroke, so that the search reaches the query.
        if (CatalogSearch.Handle(request).Count == 0)
        {
            SelectionError = "Nothing in the catalog fits that category.";
            return;
        }

        await picker.ShowAsync(request);
    }

    private async Task AssignAsync(ProductView product)
    {
        if (string.IsNullOrEmpty(DraftToken))
        {
            return;
        }

        await Session.AssignAsync(DraftToken, product.Sku);
    }

    /// <summary>
    /// Takes one box off the canvas. A box is one unit of one product, so this lowers that product's
    /// count by one, and the domain drops the product when the count reaches zero.
    /// </summary>
    private async Task RemoveItemAsync((SlotId Slot, string Sku) box)
    {
        if (string.IsNullOrEmpty(DraftToken) || Session.Current is null)
        {
            return;
        }

        var item = Session.Current.Slots
            .First(slot => slot.Slot == box.Slot)
            .Items.First(candidate => candidate.Sku == box.Sku);

        await Session.SetQuantityAsync(DraftToken, box.Slot, box.Sku, item.Quantity - 1);
    }

    private async Task OpenPickerAsync(SlotId slot)
    {
        SelectionError = null;

        // One query, for the kind of thing the clicked box holds: the desk asks for desks, an
        // accessory slot for its own subcategory. This used to load all four category entries and
        // filter the result down, so opening a box for six lamps asked the catalog for everything.
        var request = SlotCatalog.QueryFor(slot);
        pickerTitle = $"Choose a {Session.Current!.Slots.First(s => s.Slot == slot).DisplayName}";

        if (picker is null)
        {
            return;
        }

        if (CatalogSearch.Handle(request).Count == 0)
        {
            SelectionError = "Nothing in the catalog fits that slot.";
            return;
        }

        await picker.ShowAsync(request);
    }


    private Task GoToReviewAsync()
    {
        if (CanCheckout)
        {
            Navigation.NavigateTo("/review");
        }

        return Task.CompletedTask;
    }
}
