@page "/builder"
@layout BuilderLayout
@inherits WorkspaceObserver
@inject GetCatalogPageHandler CatalogPage
@inject GetCatalogGroupHandler CatalogGroup
@inject NavigationManager Navigation
<PageTitle>Workspace Builder — Core Rental</PageTitle>

<SelectionPanel />

<section class="builder-main">
    <div class="stack-md text-center">
        <h1 class="display-lg primary-text">Design Your Workspace!</h1>
        <p class="body-lg outline-text">Create your perfect setup</p>
    </div>

    @if (EmptyNotice)
    {
        <p class="alert alert--info" role="status">Add an item to your workspace before reviewing it.</p>
    }

    @if (Session.Error is not null)
    {
        <p class="alert" role="alert">@Session.Error</p>
    }

    @if (SelectionError is not null)
    {
        <p class="alert" role="alert">@SelectionError</p>
    }

    @if (Session.Current is not null)
    {
        <div class="stack-lg">
            <SlotCanvas View="Session.Current" OnPick="OpenPickerAsync" OnRemove="RemoveAsync" OnQuantityChange="ChangeQuantityAsync" />
            <ZoneList View="Session.Current" OnPick="OpenPickerAsync" OnRemove="RemoveAsync" OnQuantityChange="ChangeQuantityAsync" />
        </div>
    }

    @* The docked panel is not on screen on a phone, so the categories become a row of chips that
       open the picker already filtered, which is the same thing the panel does on a desktop. *@
    <div class="chip-row" aria-label="Categories, mobile">
        @foreach (var candidate in CatalogTabs.All)
        {
            var current = candidate;
            <button type="button" class="chip @(mobileTab == current ? null : "chip--outline")"
                    aria-pressed="@((mobileTab == current).ToString().ToLowerInvariant())"
                    @onclick="() => OpenCategoryAsync(current)">
                @CatalogTabs.LabelFor(current)
            </button>
        }
    </div>
</section>

@if (Session.Current is not null)
{
    <div class="floating-bar">
        <MonthlyTotalBar View="Session.Current" OnReady="GoToReviewAsync" />
    </div>
}

<SlotPickerDialog @ref="picker" Candidates="pickerCandidates" Title="@pickerTitle"
                  OnPick="AssignAsync" OnDismissed="ClearPicker" />

@code {
    [CascadingParameter(Name = "DraftToken")] public string? DraftToken { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "empty")] public bool EmptyNotice { get; set; }

    private SlotPickerDialog? picker;
    private IReadOnlyList<ProductListItem> pickerCandidates = [];
    private string pickerTitle = "Choose an item";
    private string? SelectionError;
    private CatalogTab mobileTab = CatalogTab.Chairs;

    private bool CanCheckout => Session.Current?.CanCheckout ?? false;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(DraftToken))
        {
            await Session.EnsureLoadedAsync(DraftToken);
        }

    }

    /// <summary>What a phone gets instead of the panel: the category's products, to pick from.</summary>
    private async Task OpenCategoryAsync(CatalogTab selected)
    {
        SelectionError = null;
        mobileTab = selected;

        pickerCandidates = CatalogTabs.Load(selected, CatalogPage, CatalogGroup);
        pickerTitle = CatalogTabs.LabelFor(selected);

        if (picker is not null && pickerCandidates.Count > 0)
        {
            await picker.ShowAsync();
        }
    }

    private async Task AssignAsync(ProductListItem product)
    {
        if (string.IsNullOrEmpty(DraftToken))
        {
            return;
        }

        await Session.AssignAsync(DraftToken, product.Sku);
    }

    private async Task RemoveAsync(SlotId slot)
    {
        if (!string.IsNullOrEmpty(DraftToken))
        {
            await Session.RemoveAsync(DraftToken, slot);
        }
    }

    private async Task ChangeQuantityAsync((SlotId Slot, int Quantity) change)
    {
        if (!string.IsNullOrEmpty(DraftToken))
        {
            await Session.SetQuantityAsync(DraftToken, change.Slot, change.Quantity);
        }
    }

    private async Task OpenPickerAsync(SlotId slot)
    {
        SelectionError = null;

        var catalog = CatalogTabs.Load(CatalogTab.Accessories, CatalogPage, CatalogGroup)
            .Concat(CatalogTabs.Load(CatalogTab.Extras, CatalogPage, CatalogGroup))
            .Concat(CatalogTabs.Load(CatalogTab.Chairs, CatalogPage, CatalogGroup))
            .Concat(CatalogTabs.Load(CatalogTab.Desks, CatalogPage, CatalogGroup))
            .ToArray();

        pickerCandidates = SlotCatalog.ForSlot(catalog, slot);
        pickerTitle = $"Choose a {Session.Current!.Slots.First(s => s.Slot == slot).DisplayName}";

        if (pickerCandidates.Count == 0)
        {
            SelectionError = "Nothing in the catalog fits that slot.";
            return;
        }

        if (picker is not null)
        {
            await picker.ShowAsync();
        }
    }

    private void ClearPicker() => pickerCandidates = [];

    private Task GoToReviewAsync()
    {
        if (CanCheckout)
        {
            Navigation.NavigateTo("/review");
        }

        return Task.CompletedTask;
    }
}
