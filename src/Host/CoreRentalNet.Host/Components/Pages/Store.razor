@page "/extras"
@layout BuilderLayout
@inject WorkspaceSession Session
@inject GetCatalogPageHandler CatalogPage
@inject GetCatalogGroupHandler CatalogGroup
<PageTitle>Accessory Store — Core Rental</PageTitle>

<SelectionPanel />

@* The design's store is one listing of extras, and so is this. It used to carry a row of category
   tabs as well; they are gone, because the design has no such row, because the panel beside them
   already browses categories, and because the page's own heading and title are about extras. The
   chevrons are drawn inline: the design sets them in an icon font, and a font that may not be
   there is a font that leaves an empty box. *@
<section class="flex-1 lg:ml-80 px-margin-mobile md:px-margin-desktop py-stack-lg min-h-screen pb-32 lg:pb-stack-lg">
    <nav class="flex items-center gap-2 text-label-md font-label-md text-on-surface-variant mb-stack-md" aria-label="Breadcrumb">
        <a class="hover:text-primary transition-colors" href="/builder">Builder</a>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 6l6 6-6 6" />
        </svg>
        <a class="hover:text-primary transition-colors" href="/extras">Extras</a>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 6l6 6-6 6" />
        </svg>
        <span class="text-primary font-bold">Summary</span>
    </nav>

    <header class="mb-stack-lg">
        <h1 class="text-display-lg font-display-lg text-on-surface mb-2">Add Your Bali Vibes</h1>
        <p class="text-body-lg font-body-lg text-on-surface-variant max-w-2xl">
            Elevate your workspace with premium extras. Enhance productivity and comfort with our
            curated selection of tropical tech lifestyle additions.
        </p>
    </header>

    @if (Session.Error is not null)
    {
        <p class="alert" role="alert">@Session.Error</p>
    }
    else if (LastAdded is not null)
    {
        <p class="alert alert--info" role="status">@LastAdded added to your workspace.</p>
    }

    @* grid-store carries no styling of its own: it is the marker the browser tests wait for on
       this page, the same way workspace-stage marks the builder. *@
    <div class="grid-store grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-gutter">
        @foreach (var product in products)
        {
            <StoreProductCard Product="product" OnSelect="AddAsync" />
        }
    </div>
</section>

@code {
    [CascadingParameter(Name = "DraftToken")] public string? DraftToken { get; set; }

    private IReadOnlyList<ProductListItem> products = [];
    private string? LastAdded;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(DraftToken))
        {
            await Session.EnsureLoadedAsync(DraftToken);
        }

        products = CatalogTabs.Load(CatalogTab.Extras, CatalogPage, CatalogGroup);
    }

    private async Task AddAsync(ProductListItem product)
    {
        if (string.IsNullOrEmpty(DraftToken))
        {
            return;
        }

        LastAdded = null;
        await Session.AssignAsync(DraftToken, product.Sku);

        if (Session.Error is null)
        {
            LastAdded = product.Name;
        }
    }
}
