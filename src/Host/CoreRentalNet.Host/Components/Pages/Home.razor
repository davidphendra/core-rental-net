@page "/"
@inject IGetFeaturedProductsHandler FeaturedProducts
<PageTitle>Core Rental — your Bali office, delivered</PageTitle>

@* The hero follows specs/design/moni_s_workspace_home/code.html: a 12-column split, the headline
   at 56px from the medium breakpoint, and two floating product cards over a tall scene. The icons
   are drawn inline rather than loaded from an icon font, so no page reaches a third party. *@
@* Ported from specs/design/moni_s_workspace_home/code.html with its class strings unchanged.
   Only the content differs: real catalogServiceue names and prices, and inline SVG where the design used
   an icon font, so the page still reaches nothing external. *@
<section class="relative min-h-[819px] flex items-center justify-center px-margin-mobile md:px-margin-desktop py-section-gap overflow-hidden bg-pattern">
    <div class="absolute inset-0 pointer-events-none opacity-30 bg-gradient-to-br from-primary-fixed/20 to-transparent mix-blend-multiply"></div>

    <!-- The design's class string, verbatim. No w-full: with width:100% this grid fills to its
         max-width, but as a flex item without it, it shrink-to-fits to its content, 1176px. -->
    <div class="relative max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-12 gap-gutter items-center z-10">
        <div class="md:col-span-6 flex flex-col items-start gap-stack-lg">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-secondary-container text-on-secondary-container text-label-md font-label-md shadow-sm">
                <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19" /></svg>
                Tropical Tech Aesthetic
            </div>

            <h1 class="text-display-lg font-display-lg text-on-surface md:text-[56px] md:leading-[64px] tracking-tight max-w-2xl">
                Your Bali Office,<br />
                <span class="text-primary relative inline-block">
                    Delivered.
                    <svg class="absolute w-full h-3 -bottom-1 left-0 text-primary-fixed-dim opacity-50" preserveAspectRatio="none" viewBox="0 0 100 10" aria-hidden="true"><path d="M0 5 Q 50 10 100 5" fill="none" stroke="currentColor" stroke-width="4" /></svg>
                </span>
            </h1>

            <p class="text-body-lg font-body-lg text-on-surface-variant max-w-xl">
                High-performance SaaS utility meets the vibrant energy of island life. Rent premium
                ergonomic setups designed for digital nomads.
            </p>

            <div class="flex flex-col sm:flex-row items-center gap-4 pt-4 w-full sm:w-auto">
                <a class="w-full sm:w-auto px-8 py-4 bg-primary text-on-primary rounded-xl text-body-md font-label-md font-bold hover:bg-on-primary-fixed transition-all hover:-translate-y-1 hover:shadow-lg shadow-md flex items-center justify-center gap-2" href="/builder">
                    Build Your Setup
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
                <a class="w-full sm:w-auto px-8 py-4 bg-transparent border-2 border-primary text-primary rounded-xl text-body-md font-label-md font-bold hover:bg-surface-container transition-all flex items-center justify-center gap-2" href="/extras">
                    View Accessories
                </a>
            </div>
        </div>

        <div class="md:col-span-6 relative h-[400px] md:h-[600px] w-full mt-stack-lg md:mt-0">
            @{ var position = 0; }
            @foreach (var product in featured)
            {
                position++;
                var tall = position == 1;
                var placement = tall
                    ? "top-[10%] right-[10%] w-64 h-80 rotate-3 shadow-[0_8px_30px_rgb(0,103,103,0.12)]"
                    : "bottom-[5%] left-[5%] w-72 h-64 -rotate-2 shadow-[0_8px_30px_rgb(0,103,103,0.08)] bg-surface/80 backdrop-blur-md";

                <div class="absolute @placement bg-surface rounded-2xl p-stack-md transform hover:rotate-0 transition-transform duration-300 flex flex-col justify-between border border-surface-container-highest">
                    <div class="flex justify-between items-start">
                        <span class="bg-secondary-container text-on-secondary-container text-[10px] uppercase font-bold px-2 py-1 rounded-full">
                            @(product.SubCategory?.ToString() ?? product.Category.ToString())
                        </span>
                        <svg class="h-6 w-6 text-outline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            @if (tall)
                            {
                                <path d="M12 20s-7-4.5-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.5-7 9-7 9z" />
                            }
                            else
                            {
                                <path d="M13 2 4 14h6l-1 8 9-12h-6z" />
                            }
                        </svg>
                    </div>

                    <div class="flex-grow flex items-center justify-center p-4">
                        <ProductImage AltText="@product.Name" ImagePath="@product.ImagePath"
                                      ImageAvailable="@product.ImageAvailable"
                                      Glyph="@ProductGlyph.ForProduct(product.Category, product.SubCategory)" />
                    </div>

                    <div class="mt-4 flex justify-between items-end">
                        <div>
                            <h3 class="text-body-md font-bold text-on-surface">@product.Name</h3>
                            <p class="text-label-md text-on-surface-variant">@product.MonthlyPrice.Amount.ToString("C") / mo</p>
                        </div>
                        @if (!tall)
                        {
                            <a class="bg-primary text-on-primary w-8 h-8 rounded-full flex items-center justify-center shadow-md hover:bg-on-primary-fixed transition-colors"
                               href="/builder" aria-label="@($"Add {product.Name} to your workspace")">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* The same treatment: the design's class strings, with inline SVG where it used an icon font. *@
<section class="py-section-gap px-margin-mobile md:px-margin-desktop bg-surface-container-low" id="how-it-works">
    <div class="max-w-container-max mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-headline-lg font-headline-lg text-on-surface mb-4">How it Works</h2>
            <p class="text-body-lg text-on-surface-variant max-w-2xl mx-auto">From concept to comfort in three simple steps.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter relative">
            <div class="hidden md:block absolute top-[50px] left-[15%] right-[15%] h-[2px] bg-outline-variant z-0 border-t-2 border-dashed border-outline-variant"></div>

            <div class="relative z-10 flex flex-col items-center text-center group">
                <div class="w-24 h-24 bg-surface rounded-full shadow-[0_4px_20px_rgb(0,103,103,0.08)] flex items-center justify-center mb-6 group-hover:-translate-y-2 transition-transform duration-300 border border-surface-variant">
                    <svg class="h-10 w-10 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 20 10-10M12 8l4 4M14 6l4 4M6 18l-2 2 4-1z" /></svg>
                </div>
                <h3 class="text-headline-md font-headline-md text-on-surface mb-2">1. Design</h3>
                <p class="text-body-md text-on-surface-variant">Use our builder to mix and match ergonomic chairs, desks, and tropical accessories.</p>
            </div>

            <div class="relative z-10 flex flex-col items-center text-center group">
                <div class="w-24 h-24 bg-surface rounded-full shadow-[0_4px_20px_rgb(0,103,103,0.08)] flex items-center justify-center mb-6 group-hover:-translate-y-2 transition-transform duration-300 border border-surface-variant">
                    <svg class="h-10 w-10 text-tertiary-container" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18l-2 8H5zM5 6 4 3H2M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM18 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z" /></svg>
                </div>
                <h3 class="text-headline-md font-headline-md text-on-surface mb-2">2. Rent</h3>
                <p class="text-body-md text-on-surface-variant">Month to month, and you can cancel any time. The first month is due when you confirm.</p>
            </div>

            <div class="relative z-10 flex flex-col items-center text-center group">
                <div class="w-24 h-24 bg-surface rounded-full shadow-[0_4px_20px_rgb(0,103,103,0.08)] flex items-center justify-center mb-6 group-hover:-translate-y-2 transition-transform duration-300 border border-surface-variant">
                    <svg class="h-10 w-10 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM6 20c2-4 4-6 6-6s4 2 6 6M4 17l4 3M20 17l-4 3" /></svg>
                </div>
                <h3 class="text-headline-md font-headline-md text-on-surface mb-2">3. Work</h3>
                <p class="text-body-md text-on-surface-variant">We deliver and assemble directly to your villa. You just focus on deep work.</p>
            </div>
        </div>
    </div>
</section>

@* Room for the fixed bottom navigation, exactly as the design leaves it. *@
<div class="h-24 lg:hidden"></div>

@code {
    private IReadOnlyList<ProductView> featured = [];

    protected override void OnInitialized()
        => featured = FeaturedProducts.Handle(new GetFeaturedProducts());
}
