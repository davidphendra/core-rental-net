@inject IHttpContextAccessor HttpContextAccessor
@inject IdentitySettings Identity
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Core Rental — your Bali office, delivered</title>
    <link rel="stylesheet" href="styles/tokens.css" />
    <link rel="stylesheet" href="styles/fonts.css" />
    <link rel="stylesheet" href="styles/tailwind.css" />
    <link rel="stylesheet" href="styles/base.css" />
    <link rel="stylesheet" href="styles/slots.css" />
    <HeadOutlet />
</head>
<body>
    <!-- The draft token is read from the request here and passed to the interactive root as a
         parameter. It has to arrive as a parameter: a cascading value declared by a static
         parent is not serialized into the circuit, so the interactive tree would never see it.
         Routes re-publishes it as a cascading value for the pages and layouts below.
         The at-sign is load-bearing: without it Razor passes the literal text "DraftToken", and every
         circuit then shares one draft. -->
    <Routes @rendermode="InteractiveServer" DraftToken="@DraftToken" Customer="Customer" StoreCategory="@StoreCategory" />
    <script src="js/store.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    /// <summary>Read during the initial request, because a circuit is not an HTTP request.</summary>
    public string DraftToken { get; private set; } = string.Empty;

    /// <summary>Who is signed in, read from the same request for the same reason.</summary>
    public CurrentCustomer Customer { get; private set; } = CurrentCustomer.Anonymous;

    /// <summary>
    /// The store's category as it was left, resolved from the cookie the browser wrote. Read here
    /// rather than in the component, because reading it later would render the wrong category first.
    /// </summary>
    public CatalogTab StoreCategory { get; private set; } = CatalogTab.Desks;

    protected override void OnInitialized()
    {
        DraftToken = DraftTokenMiddleware.ResolveToken(HttpContextAccessor.HttpContext) ?? string.Empty;
        Customer = CurrentCustomer.FromClaims(HttpContextAccessor.HttpContext?.User, Identity.RoleClaimType);
        StoreCategory = StoreCategoryPreference.Read(HttpContextAccessor.HttpContext?.Request.Cookies);
    }
}
