<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- The authorization pieces stay internal - nothing outside the application needs them - and the
         rule they enforce is still tested directly rather than through a browser. -->
    <InternalsVisibleTo Include="CoreRentalNet.Host.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>CoreRentalNet.Host</RootNamespace>
    <!-- OPENAI001: the OpenAI client's Responses surface is marked for evaluation only. It is the
         documented client for a hosted agent's Responses endpoint, and Microsoft's own hosted-agent
         sample suppresses the same diagnostic. Named here rather than suppressed globally. -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
    <UserSecretsId>f8dee84b-dfca-4aa3-befc-6914cd1a1d8f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Auth0's wrapper is the integration point; the OpenID Connect handler it wraps
         is referenced directly because the session policy is applied on that handler. -->
    <PackageReference Include="Auth0.AspNetCore.Authentication" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <!-- An access token is read for its permissions, so its token type is a direct dependency. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <!-- The client that reaches the hosted agent's Responses endpoint, and the framework abstraction
         the sample wraps it in. Stable releases both. Referenced by the Host alone: the modules reach
         the agent through ISuggestWorkspaceOptions, so no module knows an agent exists. -->
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <!-- The application's own identity: a developer credential locally, a managed identity deployed.
         No stored secret either way. -->
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Modules/Catalog/CoreRentalNet.Modules.Catalog.Infrastructure/CoreRentalNet.Modules.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Workspace/CoreRentalNet.Modules.Workspace.Application/CoreRentalNet.Modules.Workspace.Application.csproj" />
    <ProjectReference Include="../../Modules/Workspace/CoreRentalNet.Modules.Workspace.Infrastructure/CoreRentalNet.Modules.Workspace.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Rentals/CoreRentalNet.Modules.Rentals.Application/CoreRentalNet.Modules.Rentals.Application.csproj" />
    <ProjectReference Include="../../Modules/Rentals/CoreRentalNet.Modules.Rentals.Infrastructure/CoreRentalNet.Modules.Rentals.Infrastructure.csproj" />
    <ProjectReference Include="../../BuildingBlocks/CoreRentalNet.BuildingBlocks.Infrastructure/CoreRentalNet.BuildingBlocks.Infrastructure.csproj" />

  </ItemGroup>

</Project>
