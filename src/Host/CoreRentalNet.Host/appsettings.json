{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Culture": {
    "Name": "en-ID"
  },
  "Catalog": {
    "FilePath": ""
  },
  "Rentals": {
    "DeliveryFeeAmount": 750000,
    "TaxRate": 0,
    "SchedulerIntervalMinutes": 60
  },
  "Workspace": {
    "SlotCapacity": {
      "Desk": 1,
      "Chair": 1,
      "Monitor": 3,
      "Lamp": 1,
      "Plant": 1,
      "CoffeeStation": 1,
      "RelaxZone": 1
    }
  },
  "Sqlite": {
    "DatabasePath": "App_Data/corerental.db",
    "JournalMode": "WAL",
    "BusyTimeoutSeconds": 30
  },
  "Authorization": {
    "CatalogRead": {
      "ClaimType": "permissions",
      "ClaimValue": "read:catalog"
    },
    "AIUse": {
      "ClaimType": "",
      "ClaimValue": ""
    }
  },
  "Auth0": {
    "Enabled": true
  }
}
