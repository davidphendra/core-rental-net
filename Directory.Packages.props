<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Persistence">
    <!-- Pinned exactly: 10.0.0 resolves SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries a
         high-severity advisory with no fixed release in that branch. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- The vec0 extension, which is what turns a distance into a MATCH query in SQLite. It ships the
         native vec0 library for linux/osx/win and targets netstandard2.0. MIT. Authored by the sqlite-vec
         author; the package is the maintained wrapper because the official one is pinned to an old alpha. -->
    <PackageVersion Include="HiraokaHyperTools.sqlite-vec" Version="0.1.9" />
    <!-- BackgroundService, so the time-driven run has a home. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <!-- The ingestion tool reads its own appsettings.json, so its configuration comes from a file beside
         it rather than from a command line. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <!-- Auth0's package as the identity wrapper, over the standard OpenID Connect handler it is
         built on. MIT. 1.11.0 is the release that targets net10.0. -->
    <PackageVersion Include="Auth0.AspNetCore.Authentication" Version="1.11.0" />
    <!-- The handler the wrapper is built on. Referenced directly rather than left transitive: the
         two settings the wrapper does not expose (SaveTokens, GetClaimsFromUserInfoEndpoint) are
         applied on it, and pins its exact version rather than trusting resolution. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <!-- The bearer scheme a machine caller authenticates with. Its own package rather than left
         transitive: the catalogue API names it directly. MIT. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- The OpenAPI document the catalogue endpoint publishes in development, so a caller can
         discover the contract without reading the code. MIT. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- The swagger-ui page itself, served from the application in development. The document it
         renders is generated by Microsoft.AspNetCore.OpenApi above; this is the UI only. Apache-2.0. -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <!-- The token type used to read an access token's permissions. Referenced directly for the same
         reason as the handler above: the application reads it directly, so it is pinned here rather
         than left to whatever the OpenID Connect handler happens to resolve. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup Label="The workspace-suggestion agent">
    <!-- All three are preview or beta: there is no fully stable Foundry client. Pinned to the set
         Microsoft ships together in its own .NET hosted-agent sample, whose release dates agree. They
         must move together with agentfoundry/src/WorkspaceSuggestions/WorkspaceSuggestions.csproj, so a
         reader comparing the two trees finds one story rather than two. -->
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="1.20.0-preview.260831.1" />
    <PackageVersion Include="Azure.AI.Projects" Version="3.0.0-beta.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!-- Named directly by the module's embedding adapter, which takes a credential rather than resolving one. -->
    <PackageVersion Include="Azure.Core" Version="1.62.0" />
  </ItemGroup>

  <ItemGroup Label="The catalogue ingestion tool">
    <!-- Pinned to the Foundry set above, and they must move together with it: the ingestion tool reaches the
         embedding deployment through the project client, so a version of either that disagrees with
         Azure.AI.Projects is a client that cannot be built. Direct references rather than transitive, because
         the tool names these types itself and a transitive version is one that resolution chooses. -->
    <PackageVersion Include="Azure.AI.Extensions.OpenAI" Version="3.0.0-beta.2" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <!-- The transport exception type the ingestion tool's failure classifier names directly. It arrives with
         OpenAI, but the tool names it, so the tool pins it. 1.15.0 rather than 1.14.0 because the agent's
         Foundry client requires at least that, and one central version has to satisfy both. -->
    <PackageVersion Include="System.ClientModel" Version="1.15.0" />
  </ItemGroup>

  <ItemGroup Label="Chunking">
    <!-- The ingestion tool splits each product's text with this, and it is pinned exactly because its
         boundaries can change with its version. -->
    <PackageVersion Include="SemanticChunker.NET" Version="1.5.0" />
    <!-- The embedding abstraction SemanticChunker.NET is built on, named directly by the adapter that
         bridges the tool's own embedding port to it. -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup Label="The catalogue's MCP surface">
    <!-- The MCP server the catalogue's tools are published over, so a machine caller can discover and call
         them. MIT. The agent's client is pinned to the same major, so one protocol has one version on both
         sides of the wire. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Label="The catalogue's name search">
    <!-- Ranks the products a search matches, so the catalogue's name search can say which match is best
         rather than returning them in file order. MIT. Version 7.0.2 is the latest release; its 8.x line is
         still a preview, so this pins the last release rather than a preview. Its default scorer is Okapi
         BM25 (k1 = 1.2, b = 0.75), and it brings its own tokenisation, stemming and query parsing. -->
    <PackageVersion Include="Lifti.Core" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Apache-2.0. FluentAssertions 8.x is licensed for non-commercial use only. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- FakeTimeProvider, so the scheduler and the billing anchor are tested by moving the
         clock rather than by sleeping. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!-- 1.62.0 matches the Chromium revision already in the local Playwright cache. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <!-- The in-process test host: the catalogue endpoint's HTTP tests run the real application
         through its own routing, authorization and serializer rather than a stand-in. MIT. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- The suggestion contract is JSON Schema, and .NET ships no validator: the application's DTOs are
         checked against the same committed schemas the agent's tests read. Test-only. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <!-- Line coverage, so a coverage figure is a measurement rather than a claim. Test-only: a data
         collector that ships nothing. The agent tree pins the same version for the same reason. -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
